Функция КаноническаяСтрока(Значение)

	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + Значение + """";
	КонецЕсли;

		Если ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат СтроковоеПредставлениеПримитива(Значение);
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(КаноническаяСтрока(Элемент));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Части, ",") + "]";
	КонецЕсли;

	Если ЭтоОбъектJSON(Значение) Тогда
		Ключи = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Ключи.Добавить(Элемент.Ключ);
		КонецЦикла;
		ОтсортироватьСтроки(Ключи);

		Части = Новый Массив;
		Для Каждого Ключ Из Ключи Цикл
			Части.Добавить("""" + Ключ + """:" + КаноническаяСтрока(ЗначениеПоля(Значение, Ключ)));
		КонецЦикла;
		Возврат "{" + СтрСоединить(Части, ",") + "}";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция JSONСтрокаЗначения(Значение)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ЗначениеПоля(Объект, ИмяПоля, ЗначениеПоУмолчанию = Неопределено)

	Если Объект = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Объект.Свойство(ИмяПоля, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Значение = Объект.Получить(ИмяПоля);
		Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ЭтоОбъектJSON(Значение)

	Возврат ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("Массив");

