Процедура ОтсортироватьКандидатовПеремещений(Кандидаты)

	Для Индекс1 = 0 По Кандидаты.ВГраница() Цикл
		Для Индекс2 = Индекс1 + 1 По Кандидаты.ВГраница() Цикл
			Если СравнитьКандидатыПеремещений(Кандидаты[Индекс1], Кандидаты[Индекс2]) > 0 Тогда
				Обменять(Кандидаты, Индекс1, Индекс2);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция СравнитьКандидатыПеремещений(Левый, Правый)

	Если Левый.similarity <> Правый.similarity Тогда
		Возврат ?(Левый.similarity < Правый.similarity, 1, -1);
	КонецЕсли;
	ЛеваяДистанция = АбсолютноеЗначение(Левый.leftIndex - Левый.rightIndex);
	ПраваяДистанция = АбсолютноеЗначение(Правый.leftIndex - Правый.rightIndex);
	Если ЛеваяДистанция = ПраваяДистанция Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ?(ЛеваяДистанция > ПраваяДистанция, 1, -1);

КонецФункции

Процедура ОтсортироватьПарыПоПравомуИндексу(Пары)

	Для Индекс1 = 0 По Пары.ВГраница() Цикл
		Для Индекс2 = Индекс1 + 1 По Пары.ВГраница() Цикл
			Если Пары[Индекс1].rightIndex > Пары[Индекс2].rightIndex Тогда
				Обменять(Пары, Индекс1, Индекс2);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОтсортироватьСтроки(Строки)

	Для Индекс1 = 0 По Строки.ВГраница() Цикл
		Для Индекс2 = Индекс1 + 1 По Строки.ВГраница() Цикл
			Если Строки[Индекс1] > Строки[Индекс2] Тогда
				Обменять(Строки, Индекс1, Индекс2);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура Обменять(МассивЗначений, Индекс1, Индекс2)

	Значение = МассивЗначений[Индекс1];
	МассивЗначений[Индекс1] = МассивЗначений[Индекс2];
	МассивЗначений[Индекс2] = Значение;

КонецПроцедуры

Функция АбсолютноеЗначение(Значение)

	Возврат ?(Значение < 0, -Значение, Значение);

КонецФункции

Функция СократитьСтроку(Значение, МаксимальнаяДлина)

	СтрокаЗначения = Строка(Значение);
	Если СтрДлина(СтрокаЗначения) <= МаксимальнаяДлина Тогда
		Возврат СтрокаЗначения;
	КонецЕсли;
	Возврат Лев(СтрокаЗначения, МаксимальнаяДлина - 1) + "…";

КонецФункции

#КонецОбласти

#КонецЕсли
