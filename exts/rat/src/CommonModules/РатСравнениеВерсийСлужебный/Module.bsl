#Если Сервер Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Строит описание различий версий в формате diff-view.
//
// Параметры:
//  ЛеваяВерсия - Строка, Произвольный - Левая версия JSON или значение.
//  ПраваяВерсия - Строка, Произвольный - Правая версия JSON или значение.
//  Параметры - Структура, Неопределено - Параметры алгоритма:
//   * maxAlignCells - Число - Максимальный размер матрицы выравнивания.
//   * moveSimilarityThreshold - Число - Порог похожести перемещенных строк.
//   * moveMaxPairs - Число - Максимальное число пар-кандидатов перемещения.
//
// Возвращаемое значение:
//  Структура - Результат сравнения:
//   * left - Структура, Неопределено - Нормализованная левая версия.
//   * right - Структура, Неопределено - Нормализованная правая версия.
//   * fields - Массив - Различия полей.
//   * tables - Массив - Различия таблиц.
//   * errors - Массив из Строка - Ошибки разбора входных данных.
Функция ПостроитьСравнение(ЛеваяВерсия, ПраваяВерсия, Параметры = Неопределено) Экспорт

	Настройки = НастройкиСравнения(Параметры);
	Левая = РазобратьВход(ЛеваяВерсия);
	Правая = РазобратьВход(ПраваяВерсия);

	Ошибки = Новый Массив;
	Если ЗначениеЗаполнено(Левая.error) Тогда
		Ошибки.Добавить("Левая версия: " + Левая.error);
	КонецЕсли;
	Если ЗначениеЗаполнено(Правая.error) Тогда
		Ошибки.Добавить("Правая версия: " + Правая.error);
	КонецЕсли;

	ЛевыеПоля = Новый Соответствие;
	ПравыеПоля = Новый Соответствие;
	ЛевыеТаблицы = Новый Соответствие;
	ПравыеТаблицы = Новый Соответствие;

	Собрать(Левая.node, "", ЛевыеПоля, ЛевыеТаблицы);
	Собрать(Правая.node, "", ПравыеПоля, ПравыеТаблицы);

	Результат = Новый Структура;
	Результат.Вставить("left", Левая.node);
	Результат.Вставить("right", Правая.node);
	Результат.Вставить("fields", СтрокиПолей(ЛевыеПоля, ПравыеПоля));
	Результат.Вставить("tables", СравненияТаблиц(ЛевыеТаблицы, ПравыеТаблицы, Настройки));
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НастройкиСравнения(Параметры)

	Настройки = Новый Структура;
	Настройки.Вставить("maxAlignCells", 50000);
	Настройки.Вставить("moveSimilarityThreshold", 0.8);
	Настройки.Вставить("moveMaxPairs", 5000);

	Если Параметры <> Неопределено Тогда
		УстановитьНастройку(Настройки, Параметры, "maxAlignCells");
		УстановитьНастройку(Настройки, Параметры, "moveSimilarityThreshold");
		УстановитьНастройку(Настройки, Параметры, "moveMaxPairs");
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Процедура УстановитьНастройку(Настройки, Параметры, ИмяПоля)

	ЗначениеПараметра = ЗначениеПоля(Параметры, ИмяПоля);
	Если ЗначениеПараметра <> Неопределено Тогда
		Настройки[ИмяПоля] = ЗначениеПараметра;
	КонецЕсли;

КонецПроцедуры

Функция РазобратьВход(Вход)

	Если Вход = Неопределено Тогда
		Возврат НовыйРезультатРазбора(Неопределено);
	КонецЕсли;

	Если ТипЗнч(Вход) = Тип("Строка") Тогда
		Если ПустаяСтрока(Вход) Тогда
			Возврат НовыйРезультатРазбора(Неопределено);
		КонецЕсли;

		Попытка
			Значение = РатJSON.ОбъектИзСтрокиСПриведением(Вход);
			Возврат НовыйРезультатРазбора(НормализоватьЗначение(Значение));
		Исключение
			Возврат НовыйРезультатРазбора(Неопределено, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Возврат НовыйРезультатРазбора(НормализоватьЗначение(Вход));

КонецФункции

Функция НовыйРезультатРазбора(Узел, Ошибка = Неопределено)

	Возврат Новый Структура("node, error", Узел, Ошибка);

КонецФункции

Функция НормализоватьЗначение(Значение)

	Если ЭтоОбъектJSON(Значение) Тогда
		ТипОбъекта = ЗначениеПоля(Значение, "type");
		Если ТипОбъекта = "table" Тогда
			Возврат НормализоватьТаблицу(Значение);
		КонецЕсли;

		Если ТипОбъекта = "structure" Тогда
			Поля = Новый Соответствие;
			СырыеПоля = ЗначениеПоля(Значение, "fields", Новый Соответствие);
			Если ЭтоОбъектJSON(СырыеПоля) Тогда
				Для Каждого Элемент Из СырыеПоля Цикл
					Поля.Вставить(Элемент.Ключ, НормализоватьЗначение(Элемент.Значение));
				КонецЦикла;
			КонецЕсли;
			Возврат НовыйУзелСтруктуры(Поля);
		КонецЕсли;

		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Возврат НовыйУзелЗначения(Значение);
		КонецЕсли;

		Поля = Новый Соответствие;
		Для Каждого Элемент Из Значение Цикл
			Поля.Вставить(Элемент.Ключ, НормализоватьЗначение(Элемент.Значение));
		КонецЦикла;
		Возврат НовыйУзелСтруктуры(Поля);
	КонецЕсли;

	Возврат НовыйУзелЗначения(Значение);

КонецФункции

Функция НормализоватьТаблицу(Значение)

	Колонки = Новый Массив;
	СырыеКолонки = ЗначениеПоля(Значение, "columns");
	Если ТипЗнч(СырыеКолонки) = Тип("Массив") Тогда
		Для Каждого Колонка Из СырыеКолонки Цикл
			Если ТипЗнч(Колонка) = Тип("Строка") Тогда
				Колонки.Добавить(Колонка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Строки = Новый Массив;
	СырыеСтроки = ЗначениеПоля(Значение, "rows");
	Если ТипЗнч(СырыеСтроки) = Тип("Массив") Тогда
		Для Индекс = 0 По СырыеСтроки.ВГраница() Цикл
			Строки.Добавить(НормализоватьСтроку(СырыеСтроки[Индекс], Индекс, Колонки));
		КонецЦикла;
	КонецЕсли;

	Если Колонки.Количество() = 0 Тогда
		Увиденные = Новый Соответствие;
		Для Каждого СтрокаТаблицы Из Строки Цикл
			Для Каждого Ячейка Из СтрокаТаблицы.cells Цикл
				Если Увиденные.Получить(Ячейка.Ключ) = Неопределено Тогда
					Увиденные.Вставить(Ячейка.Ключ, Истина);
					Колонки.Добавить(Ячейка.Ключ);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Имя = ЗначениеПоля(Значение, "name");
	Если Имя = Неопределено Тогда
		Имя = ЗначениеПоля(Значение, "title");
	КонецЕсли;
	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Имя = Неопределено;
	КонецЕсли;

	ЕстьЯвныеИдентификаторы = Ложь;
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Если СтрокаТаблицы.hasExplicitId Тогда
			ЕстьЯвныеИдентификаторы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат НовыйУзелТаблицы(Колонки, Строки, Имя, ЕстьЯвныеИдентификаторы);

КонецФункции

Функция НормализоватьСтроку(Значение, Индекс, Колонки)

	СтрокаОбъекта = ?(ЭтоОбъектJSON(Значение), Значение, Неопределено);
	Идентификатор = ЗначениеПоля(СтрокаОбъекта, "id");
	Если Идентификатор = Неопределено Тогда
		Идентификатор = ЗначениеПоля(СтрокаОбъекта, "$id");
	КонецЕсли;
	Если Идентификатор = Неопределено Тогда
		Идентификатор = ЗначениеПоля(СтрокаОбъекта, "key");
	КонецЕсли;

	ЕстьЯвныйИдентификатор = Идентификатор <> Неопределено;
	ОтображаемыйИдентификатор = ?(ЕстьЯвныйИдентификатор, Строка(Идентификатор), Строка(Индекс + 1));

	Ячейки = ЗначениеПоля(СтрокаОбъекта, "cells");
	Если Ячейки = Неопределено Тогда
		Ячейки = ЗначениеПоля(СтрокаОбъекта, "values");
	КонецЕсли;
	Если Ячейки = Неопределено Тогда
		Ячейки = СтрокаОбъекта;
	КонецЕсли;

	Если ТипЗнч(Ячейки) = Тип("Массив") Тогда
		Маппинг = Новый Соответствие;
		Для ИндексКолонки = 0 По Колонки.ВГраница() Цикл
			Если ИндексКолонки <= Ячейки.ВГраница() Тогда
				Маппинг.Вставить(Колонки[ИндексКолонки], Ячейки[ИндексКолонки]);
			КонецЕсли;
		КонецЦикла;
		Ячейки = Маппинг;
	КонецЕсли;

	НормализованныеЯчейки = Новый Соответствие;
	Если ЭтоОбъектJSON(Ячейки) Тогда
		Для Каждого Ячейка Из Ячейки Цикл
			НормализованныеЯчейки.Вставить(Ячейка.Ключ, НормализоватьЗначение(Ячейка.Значение));
		КонецЦикла;
	КонецЕсли;

	Возврат НовыйСтрокаТаблицы(ОтображаемыйИдентификатор, НормализованныеЯчейки, ЕстьЯвныйИдентификатор);

КонецФункции

Функция НовыйУзелЗначения(Значение)

	Возврат Новый Структура("kind, value", "value", Значение);

КонецФункции

Функция НовыйУзелСтруктуры(Поля)

	Возврат Новый Структура("kind, fields", "structure", Поля);

КонецФункции

Функция НовыйУзелТаблицы(Колонки, Строки, Имя, ЕстьЯвныеИдентификаторы)

	Результат = Новый Структура("kind, columns, rows", "table", Колонки, Строки);
	Результат.Вставить("name", Имя);
	Результат.Вставить("hasExplicitIds", ЕстьЯвныеИдентификаторы);
	Возврат Результат;

КонецФункции

Функция НовыйСтрокаТаблицы(Идентификатор, Ячейки, ЕстьЯвныйИдентификатор)

	Возврат Новый Структура("id, displayId, cells, hasExplicitId", Идентификатор, Идентификатор, Ячейки, ЕстьЯвныйИдентификатор);

КонецФункции

Процедура Собрать(Узел, Путь, Поля, Таблицы)

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Узел.kind = "structure" Тогда
		Для Каждого Элемент Из Узел.fields Цикл
			СледующийПуть = ?(ПустаяСтрока(Путь), Элемент.Ключ, Путь + "." + Элемент.Ключ);
			Дочерний = Элемент.Значение;
			Если Дочерний.kind = "table" Тогда
				Таблицы.Вставить(СледующийПуть, Дочерний);
			ИначеЕсли Дочерний.kind = "structure" Тогда
				Собрать(Дочерний, СледующийПуть, Поля, Таблицы);
			Иначе
				Поля.Вставить(СледующийПуть, Дочерний.value);
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Если Узел.kind = "table" Тогда
		Таблицы.Вставить(?(ПустаяСтрока(Путь), "ROOT", Путь), Узел);
		Возврат;
	КонецЕсли;

	Поля.Вставить(?(ПустаяСтрока(Путь), "ROOT", Путь), Узел.value);

КонецПроцедуры

Функция СтрокиПолей(ЛевыеПоля, ПравыеПоля)

	Ключи = ОбъединенныеКлючи(ЛевыеПоля, ПравыеПоля);
	ОтсортироватьСтроки(Ключи);

	Результат = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		Левое = ЛевыеПоля.Получить(Ключ);
		Правое = ПравыеПоля.Получить(Ключ);
		ЛевыйТекст = ПредставлениеПоля(Левое);
		ПравыйТекст = ПредставлениеПоля(Правое);

		Статус = "unchanged";
		Если Левое = Неопределено И Правое <> Неопределено Тогда
			Статус = "added";
		ИначеЕсли Левое <> Неопределено И Правое = Неопределено Тогда
			Статус = "removed";
		ИначеЕсли КаноническаяСтрока(Левое) <> КаноническаяСтрока(Правое) Тогда
			Статус = "changed";
		КонецЕсли;

		СтрокаПоля = Новый Структура("key, l, r, status", Ключ, ЛевыйТекст, ПравыйТекст, Статус);
		Если Статус = "changed" Тогда
			СтрокаПоля.Вставить("parts", ЧастиРазличий(ЛевыйТекст, ПравыйТекст));
		КонецЕсли;
		Результат.Добавить(СтрокаПоля);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СравненияТаблиц(ЛевыеТаблицы, ПравыеТаблицы, Настройки)

	Пути = ОбъединенныеКлючи(ЛевыеТаблицы, ПравыеТаблицы);
	ОтсортироватьСтроки(Пути);

	Результат = Новый Массив;
	Для Каждого Путь Из Пути Цикл
		ЛеваяТаблица = ЛевыеТаблицы.Получить(Путь);
		ПраваяТаблица = ПравыеТаблицы.Получить(Путь);
		Колонки = ОбъединитьКолонки(КолонкиТаблицы(ЛеваяТаблица), КолонкиТаблицы(ПраваяТаблица));
		Строки = ВыровнятьСтроки(СтрокиТаблицы(ЛеваяТаблица), СтрокиТаблицы(ПраваяТаблица), Колонки, Настройки);

		Сравнение = Новый Структура("path, title, columns, rows", Путь, ЗаголовокТаблицы(ЛеваяТаблица, ПраваяТаблица), Колонки, Строки);
		Результат.Добавить(Сравнение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВыровнятьСтроки(ЛевыеСтроки, ПравыеСтроки, Колонки, Настройки)

	Если ЛевыеСтроки.Количество() * ПравыеСтроки.Количество() > Настройки.maxAlignCells Тогда
		Возврат ВыровнятьСтрокиПоИдентификатору(ЛевыеСтроки, ПравыеСтроки, Колонки);
	КонецЕсли;

	ПеремещенныеПары = НайтиПеремещенныеПары(ЛевыеСтроки, ПравыеСтроки, Колонки, Настройки);
	ПеремещенныеЛевые = Новый Соответствие;
	ПеремещенныеПравые = Новый Соответствие;
	Для Каждого Пара Из ПеремещенныеПары Цикл
		ПеремещенныеЛевые.Вставить(Пара.leftIndex, Истина);
		ПеремещенныеПравые.Вставить(Пара.rightIndex, Истина);
	КонецЦикла;

	ЛевыеОстаток = Новый Массив;
	ПравыеОстаток = Новый Массив;
	ИндексыЛевых = Новый Массив;
	ИндексыПравых = Новый Массив;

	Для Индекс = 0 По ЛевыеСтроки.ВГраница() Цикл
		Если ПеремещенныеЛевые.Получить(Индекс) = Неопределено Тогда
			ЛевыеОстаток.Добавить(ЛевыеСтроки[Индекс]);
			ИндексыЛевых.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;
	Для Индекс = 0 По ПравыеСтроки.ВГраница() Цикл
		Если ПеремещенныеПравые.Получить(Индекс) = Неопределено Тогда
			ПравыеОстаток.Добавить(ПравыеСтроки[Индекс]);
			ИндексыПравых.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Матрица = МатрицаЧисел(ЛевыеОстаток.Количество() + 1, ПравыеОстаток.Количество() + 1);
	Ходы = МатрицаСтрок(ЛевыеОстаток.Количество() + 1, ПравыеОстаток.Количество() + 1);

	Для Индекс = 1 По ЛевыеОстаток.Количество() Цикл
		Матрица[Индекс][0] = Матрица[Индекс - 1][0] + 1;
		Ходы[Индекс][0] = "D";
	КонецЦикла;
	Для Индекс = 1 По ПравыеОстаток.Количество() Цикл
		Матрица[0][Индекс] = Матрица[0][Индекс - 1] + 1;
		Ходы[0][Индекс] = "I";
	КонецЦикла;

	Для ИндексЛевого = 1 По ЛевыеОстаток.Количество() Цикл
		Для ИндексПравого = 1 По ПравыеОстаток.Количество() Цикл
			Похожесть = ОписаниеПохожести(ЛевыеОстаток[ИндексЛевого - 1], ПравыеОстаток[ИндексПравого - 1], Колонки);
			СтоимостьЗамены = ?(Похожесть.same, 0, ?(Похожесть.similar, Похожесть.ratio, 2));
			Удаление = Матрица[ИндексЛевого - 1][ИндексПравого] + 1;
			Вставка = Матрица[ИндексЛевого][ИндексПравого - 1] + 1;
			Замена = Матрица[ИндексЛевого - 1][ИндексПравого - 1] + СтоимостьЗамены;
			Лучшее = Мин(Удаление, Мин(Вставка, Замена));
			Матрица[ИндексЛевого][ИндексПравого] = Лучшее;
			Ходы[ИндексЛевого][ИндексПравого] = ?(Лучшее = Замена, "S", ?(Лучшее = Удаление, "D", "I"));
		КонецЦикла;
	КонецЦикла;

	Строки = Новый Массив;
	ИндексыПравыхСтрок = Новый Массив;
	ИндексЛевого = ЛевыеОстаток.Количество();
	ИндексПравого = ПравыеОстаток.Количество();

	Пока ИндексЛевого > 0 Или ИндексПравого > 0 Цикл
		Ход = Ходы[ИндексЛевого][ИндексПравого];
		Если Ход = "S" Тогда
			ДобавитьСтрокуЗамены(Строки, ИндексыПравыхСтрок, ЛевыеОстаток, ПравыеОстаток, ИндексыЛевых, ИндексыПравых, ИндексЛевого, ИндексПравого, Колонки);
			ИндексЛевого = ИндексЛевого - 1;
			ИндексПравого = ИндексПравого - 1;
		ИначеЕсли Ход = "D" Тогда
			ЛевыйИндекс = ИндексыЛевых[ИндексЛевого - 1];
			Строки.Добавить(НоваяСтрокаРазличий(ЛевыеОстаток[ИндексЛевого - 1].displayId, ЛевыеОстаток[ИндексЛевого - 1], Неопределено, "removed", "g-" + Строка(ЛевыйИндекс) + "-d"));
			ИндексыПравыхСтрок.Добавить(Неопределено);
			ИндексЛевого = ИндексЛевого - 1;
		Иначе
			ПравыйИндекс = ИндексыПравых[ИндексПравого - 1];
			Строки.Добавить(НоваяСтрокаРазличий(ПравыеОстаток[ИндексПравого - 1].displayId, Неопределено, ПравыеОстаток[ИндексПравого - 1], "added", "g-" + Строка(ПравыйИндекс) + "-i"));
			ИндексыПравыхСтрок.Добавить(ПравыйИндекс);
			ИндексПравого = ИндексПравого - 1;
		КонецЕсли;
	КонецЦикла;

	Строки = ОбратитьМассив(Строки);
	ИндексыПравыхСтрок = ОбратитьМассив(ИндексыПравыхСтрок);
	Если ПеремещенныеПары.Количество() = 0 Тогда
		Возврат Строки;
	КонецЕсли;

	Возврат ВставитьПеремещенныеСтроки(Строки, ИндексыПравыхСтрок, ПостроитьПеремещенныеСтроки(ПеремещенныеПары, ЛевыеСтроки, ПравыеСтроки, Колонки));

КонецФункции

Процедура ДобавитьСтрокуЗамены(Строки, ИндексыПравыхСтрок, ЛевыеОстаток, ПравыеОстаток, ИндексыЛевых, ИндексыПравых, ИндексЛевого, ИндексПравого, Колонки)

	ЛеваяСтрока = ЛевыеОстаток[ИндексЛевого - 1];
	ПраваяСтрока = ПравыеОстаток[ИндексПравого - 1];
	ЛевыйИндекс = ИндексыЛевых[ИндексЛевого - 1];
	ПравыйИндекс = ИндексыПравых[ИндексПравого - 1];
	Похожесть = ОписаниеПохожести(ЛеваяСтрока, ПраваяСтрока, Колонки);
	Идентификатор = ЛеваяСтрока.displayId;

	Если Похожесть.same Тогда
		Строки.Добавить(НоваяСтрокаРазличий(Идентификатор, ЛеваяСтрока, ПраваяСтрока, "unchanged", "g-" + Строка(ЛевыйИндекс) + "-" + Строка(ПравыйИндекс)));
		ИндексыПравыхСтрок.Добавить(ПравыйИндекс);
	ИначеЕсли Похожесть.similar Тогда
		СтрокаРазличий = НоваяСтрокаРазличий(Идентификатор, ЛеваяСтрока, ПраваяСтрока, "changed", "g-" + Строка(ЛевыйИндекс) + "-" + Строка(ПравыйИндекс));
		СтрокаРазличий.Вставить("cellDiffs", РазличияЯчеек(ЛеваяСтрока, ПраваяСтрока, Колонки));
		Строки.Добавить(СтрокаРазличий);
		ИндексыПравыхСтрок.Добавить(ПравыйИндекс);
	Иначе
		ИдентификаторПары = "pair-" + Строка(ЛевыйИндекс) + "-" + Строка(ПравыйИндекс);
		РазличияЯчеек = РазличияЯчеек(ЛеваяСтрока, ПраваяСтрока, Колонки);
		Удаленная = НоваяСтрокаРазличий(Идентификатор, ЛеваяСтрока, Неопределено, "removed", ИдентификаторПары);
		Удаленная.Вставить("pair", ПраваяСтрока);
		Удаленная.Вставить("cellDiffs", РазличияЯчеек);
		Добавленная = НоваяСтрокаРазличий(Идентификатор, Неопределено, ПраваяСтрока, "added", ИдентификаторПары);
		Добавленная.Вставить("pair", ЛеваяСтрока);
		Добавленная.Вставить("cellDiffs", РазличияЯчеек);
		Строки.Добавить(Удаленная);
		ИндексыПравыхСтрок.Добавить(Неопределено);
		Строки.Добавить(Добавленная);
		ИндексыПравыхСтрок.Добавить(ПравыйИндекс);
	КонецЕсли;

КонецПроцедуры

Функция ВыровнятьСтрокиПоИдентификатору(ЛевыеСтроки, ПравыеСтроки, Колонки)

	Левые = ИндексСтрокПоИдентификатору(ЛевыеСтроки);
	Правые = ИндексСтрокПоИдентификатору(ПравыеСтроки);
	Идентификаторы = ОбъединенныеКлючи(Левые, Правые);

	Результат = Новый Массив;
	Для Индекс = 0 По Идентификаторы.ВГраница() Цикл
		Идентификатор = Идентификаторы[Индекс];
		ЛеваяСтрока = Левые.Получить(Идентификатор);
		ПраваяСтрока = Правые.Получить(Идентификатор);
		Если ЛеваяСтрока <> Неопределено И ПраваяСтрока <> Неопределено И СтрокиРавны(ЛеваяСтрока, ПраваяСтрока, Колонки) Тогда
			Статус = "unchanged";
		ИначеЕсли ЛеваяСтрока <> Неопределено И ПраваяСтрока <> Неопределено Тогда
			Статус = "changed";
		ИначеЕсли ЛеваяСтрока <> Неопределено Тогда
			Статус = "removed";
		Иначе
			Статус = "added";
		КонецЕсли;

		СтрокаРазличий = НоваяСтрокаРазличий(Идентификатор, ЛеваяСтрока, ПраваяСтрока, Статус, "fallback-" + Строка(Индекс));
		Если Статус = "changed" Тогда
			СтрокаРазличий.Вставить("cellDiffs", РазличияЯчеек(ЛеваяСтрока, ПраваяСтрока, Колонки));
		КонецЕсли;
		Результат.Добавить(СтрокаРазличий);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиПеремещенныеПары(ЛевыеСтроки, ПравыеСтроки, Колонки, Настройки)

	Кандидаты = Новый Массив;
	Для ЛевыйИндекс = 0 По ЛевыеСтроки.ВГраница() Цикл
		Для ПравыйИндекс = 0 По ПравыеСтроки.ВГраница() Цикл
			Похожесть = ПохожестьСтрок(ЛевыеСтроки[ЛевыйИндекс], ПравыеСтроки[ПравыйИндекс], Колонки);
			Если Похожесть >= Настройки.moveSimilarityThreshold Тогда
				Кандидаты.Добавить(Новый Структура("leftIndex, rightIndex, similarity", ЛевыйИндекс, ПравыйИндекс, Похожесть));
				Если Кандидаты.Количество() > Настройки.moveMaxPairs Тогда
					Возврат Новый Массив;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ОтсортироватьКандидатовПеремещений(Кандидаты);
	ЗанятыеЛевые = Новый Соответствие;
	ЗанятыеПравые = Новый Соответствие;
	Сопоставленные = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ЗанятыеЛевые.Получить(Кандидат.leftIndex) <> Неопределено Или ЗанятыеПравые.Получить(Кандидат.rightIndex) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗанятыеЛевые.Вставить(Кандидат.leftIndex, Истина);
		ЗанятыеПравые.Вставить(Кандидат.rightIndex, Истина);
		Сопоставленные.Добавить(Кандидат);
	КонецЦикла;

	Если Сопоставленные.Количество() < 2 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Упорядоченные = КопияМассива(Сопоставленные);
	ОтсортироватьПарыПоПравомуИндексу(Упорядоченные);
	Последовательность = Новый Массив;
	Для Каждого Пара Из Упорядоченные Цикл
		Последовательность.Добавить(Пара.leftIndex);
	КонецЦикла;
	ИндексыLIS = ИндексыLIS(Последовательность);

	Перемещенные = Новый Массив;
	Для Индекс = 0 По Упорядоченные.ВГраница() Цикл
		Если ИндексыLIS.Получить(Индекс) = Неопределено Тогда
			Перемещенные.Добавить(Упорядоченные[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Возврат Перемещенные;

КонецФункции

Функция ПостроитьПеремещенныеСтроки(ПеремещенныеПары, ЛевыеСтроки, ПравыеСтроки, Колонки)

	Пары = КопияМассива(ПеремещенныеПары);
	ОтсортироватьПарыПоПравомуИндексу(Пары);
	Результат = Новый Массив;

	Для Каждого Пара Из Пары Цикл
		ЛеваяСтрока = ЛевыеСтроки[Пара.leftIndex];
		ПраваяСтрока = ПравыеСтроки[Пара.rightIndex];
		ИдентификаторПеремещения = "move-" + Строка(Пара.leftIndex) + "-" + Строка(Пара.rightIndex);
		СтрокаРазличий = НоваяСтрокаРазличий(ЛеваяСтрока.displayId, Неопределено, ПраваяСтрока, "moved", ИдентификаторПеремещения);
		СтрокаРазличий.Вставить("moveId", ИдентификаторПеремещения);
		СтрокаРазличий.Вставить("moveRole", "to");
		СтрокаРазличий.Вставить("moveFromIndex", Пара.leftIndex);
		СтрокаРазличий.Вставить("moveToIndex", Пара.rightIndex);
		СтрокаРазличий.Вставить("pair", ЛеваяСтрока);
		СтрокаРазличий.Вставить("cellDiffs", РазличияЯчеек(ЛеваяСтрока, ПраваяСтрока, Колонки));
		Результат.Добавить(Новый Структура("rightIndex, rows", Пара.rightIndex, Новый Массив));
		Результат[Результат.ВГраница()].rows.Добавить(СтрокаРазличий);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВставитьПеремещенныеСтроки(БазовыеСтроки, ИндексыПравыхСтрок, ПеремещенныеГруппы)

	Результат = КопияМассива(БазовыеСтроки);
	Индексы = КопияМассива(ИндексыПравыхСтрок);

	Для Каждого Группа Из ПеремещенныеГруппы Цикл
		ПозицияВставки = -1;
		Для Индекс = 0 По Индексы.ВГраница() Цикл
			Если Индексы[Индекс] <> Неопределено И Индексы[Индекс] > Группа.rightIndex Тогда
				ПозицияВставки = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ПозицияВставки = -1 Тогда
			Для Каждого СтрокаГруппы Из Группа.rows Цикл
				Результат.Добавить(СтрокаГруппы);
				Индексы.Добавить(Группа.rightIndex);
			КонецЦикла;
		Иначе
			Для Каждого СтрокаГруппы Из Группа.rows Цикл
				Результат.Вставить(ПозицияВставки, СтрокаГруппы);
				Индексы.Вставить(ПозицияВставки, Группа.rightIndex);
				ПозицияВставки = ПозицияВставки + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РазличияЯчеек(ЛеваяСтрока, ПраваяСтрока, Колонки)

	Результат = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		ЛевыйТекст = ТекстЯчейки(ЛеваяСтрока, Колонка);
		ПравыйТекст = ТекстЯчейки(ПраваяСтрока, Колонка);
		Результат.Вставить(Колонка, Новый Структура(
			"leftText, rightText, leftNull, rightNull, parts",
			ЛевыйТекст,
			ПравыйТекст,
			ЭтоПустаяЯчейка(ЗначениеЯчейки(ЛеваяСтрока, Колонка)),
			ЭтоПустаяЯчейка(ЗначениеЯчейки(ПраваяСтрока, Колонка)),
			ЧастиРазличий(ЛевыйТекст, ПравыйТекст)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НоваяСтрокаРазличий(Идентификатор, ЛеваяСтрока, ПраваяСтрока, Статус, ИдентификаторГруппы)

	Возврат Новый Структура("id, l, r, status, groupId", Идентификатор, ЛеваяСтрока, ПраваяСтрока, Статус, ИдентификаторГруппы);

КонецФункции

Функция ОписаниеПохожести(ЛеваяСтрока, ПраваяСтрока, Колонки)

	Если ЛеваяСтрока = Неопределено Или ПраваяСтрока = Неопределено Тогда
		Возврат Новый Структура("same, similar, ratio, similarity", Ложь, Ложь, 1, 0);
	КонецЕсли;

	Если СтрокиРавны(ЛеваяСтрока, ПраваяСтрока, Колонки) Тогда
		Возврат Новый Структура("same, similar, ratio, similarity", Истина, Истина, 0, 1);
	КонецЕсли;

	Похожесть = ПохожестьСтрок(ЛеваяСтрока, ПраваяСтрока, Колонки);
	Возврат Новый Структура("same, similar, ratio, similarity", Ложь, Похожесть >= 0.6, 1 - Похожесть, Похожесть);

КонецФункции

Функция ПохожестьСтрок(ЛеваяСтрока, ПраваяСтрока, Колонки)

	Если ЛеваяСтрока = Неопределено Или ПраваяСтрока = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ЛеваяПодпись = ПодписьСтроки(ЛеваяСтрока, Колонки);
	ПраваяПодпись = ПодписьСтроки(ПраваяСтрока, Колонки);
	МаксимальнаяДлина = Макс(СтрДлина(ЛеваяПодпись), СтрДлина(ПраваяПодпись));
	Если МаксимальнаяДлина = 0 Тогда
		Возврат 1;
	КонецЕсли;

	Если МаксимальнаяДлина > 300 Тогда
		Возврат ПохожестьТокенов(ЛеваяПодпись, ПраваяПодпись);
	КонецЕсли;

	Возврат Макс(0, 1 - РасстояниеЛевенштейна(ЛеваяПодпись, ПраваяПодпись) / МаксимальнаяДлина);

КонецФункции

Функция СтрокиРавны(ЛеваяСтрока, ПраваяСтрока, Колонки)

	Если ЛеваяСтрока = Неопределено Или ПраваяСтрока = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Если ТекстЯчейки(ЛеваяСтрока, Колонка) <> ТекстЯчейки(ПраваяСтрока, Колонка) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ПодписьСтроки(СтрокаТаблицы, Колонки)

	Части = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		Части.Добавить(ТекстЯчейки(СтрокаТаблицы, Колонка));
	КонецЦикла;
	Возврат СтрСоединить(Части, "|");

КонецФункции

Функция ТекстЯчейки(СтрокаТаблицы, Колонка)

	Значение = ЗначениеЯчейки(СтрокаТаблицы, Колонка);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ЭтоОбъектJSON(Значение) И ЗначениеПоля(Значение, "kind") <> Неопределено Тогда
		Возврат СтроковоеПредставлениеУзла(Значение);
	КонецЕсли;

	Возврат СтроковоеПредставлениеПримитива(Значение);

КонецФункции

Функция ЗначениеЯчейки(СтрокаТаблицы, Колонка)

	Если СтрокаТаблицы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрокаТаблицы.cells.Получить(Колонка);

КонецФункции

Функция ЭтоПустаяЯчейка(Значение)

	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоОбъектJSON(Значение) И ЗначениеПоля(Значение, "kind") = "value" И ЗначениеПоля(Значение, "value") = Неопределено;

КонецФункции

Функция СтроковоеПредставлениеУзла(Узел)

	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если Узел.kind = "value" Тогда
		Возврат ?(Узел.value = Неопределено, "", СтроковоеПредставлениеПримитива(Узел.value));
	КонецЕсли;

	Если Узел.kind = "table" Тогда
		Возврат "[table " + Строка(Узел.rows.Количество()) + "x" + Строка(Узел.columns.Количество()) + "]";
	КонецЕсли;

	Возврат СократитьСтроку(КаноническаяСтрока(ОбычноеЗначениеУзла(Узел)), 200);

КонецФункции

Функция ОбычноеЗначениеУзла(Узел)

	Если Узел = Неопределено Или НЕ ЭтоОбъектJSON(Узел) Тогда
		Возврат Узел;
	КонецЕсли;

	Если Узел.kind = "value" Тогда
		Возврат Узел.value;
	КонецЕсли;

	Если Узел.kind = "table" Тогда
		Строки = Новый Массив;
		Для Каждого СтрокаТаблицы Из Узел.rows Цикл
			Ячейки = Новый Соответствие;
			Для Каждого Ячейка Из СтрокаТаблицы.cells Цикл
				Ячейки.Вставить(Ячейка.Ключ, ОбычноеЗначениеУзла(Ячейка.Значение));
			КонецЦикла;
			Строки.Добавить(Новый Структура("id, cells", СтрокаТаблицы.id, Ячейки));
		КонецЦикла;
		Возврат Новый Структура("type, columns, rows", "table", Узел.columns, Строки);
	КонецЕсли;

	Результат = Новый Соответствие;
	Для Каждого Поле Из Узел.fields Цикл
		Результат.Вставить(Поле.Ключ, ОбычноеЗначениеУзла(Поле.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПредставлениеПоля(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЭтоОбъектJSON(Значение) Тогда
		Возврат СократитьСтроку(КаноническаяСтрока(Значение), 200);
	КонецЕсли;

	Возврат СтроковоеПредставлениеПримитива(Значение);

КонецФункции

Функция СтроковоеПредставлениеПримитива(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат JSONСтрокаЗначения(Значение);
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ЧастиРазличий(Левое, Правое)

	ЛевыйТекст = ?(Левое = Неопределено, "", СтроковоеПредставлениеПримитива(Левое));
	ПравыйТекст = ?(Правое = Неопределено, "", СтроковоеПредставлениеПримитива(Правое));
	ДлинаЛевого = СтрДлина(ЛевыйТекст);
	ДлинаПравого = СтрДлина(ПравыйТекст);

	Если ДлинаЛевого = 0 И ДлинаПравого = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если ДлинаЛевого * ДлинаПравого > 200000 Или ДлинаЛевого > 4000 Или ДлинаПравого > 4000 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Матрица = МатрицаЧисел(ДлинаЛевого + 1, ДлинаПравого + 1);
	Для ИндексЛевого = 1 По ДлинаЛевого Цикл
		Для ИндексПравого = 1 По ДлинаПравого Цикл
			Если Сред(ЛевыйТекст, ИндексЛевого, 1) = Сред(ПравыйТекст, ИндексПравого, 1) Тогда
				Матрица[ИндексЛевого][ИндексПравого] = Матрица[ИндексЛевого - 1][ИндексПравого - 1] + 1;
			Иначе
				Матрица[ИндексЛевого][ИндексПравого] = Макс(Матрица[ИндексЛевого - 1][ИндексПравого], Матрица[ИндексЛевого][ИндексПравого - 1]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Массив;
	ИндексЛевого = ДлинаЛевого;
	ИндексПравого = ДлинаПравого;
	Пока ИндексЛевого > 0 И ИндексПравого > 0 Цикл
		Если Сред(ЛевыйТекст, ИндексЛевого, 1) = Сред(ПравыйТекст, ИндексПравого, 1) Тогда
			Результат.Добавить(НоваяЧастьРазличий("eq", Сред(ЛевыйТекст, ИндексЛевого, 1)));
			ИндексЛевого = ИндексЛевого - 1;
			ИндексПравого = ИндексПравого - 1;
		ИначеЕсли Матрица[ИндексЛевого - 1][ИндексПравого] >= Матрица[ИндексЛевого][ИндексПравого - 1] Тогда
			Результат.Добавить(НоваяЧастьРазличий("del", Сред(ЛевыйТекст, ИндексЛевого, 1)));
			ИндексЛевого = ИндексЛевого - 1;
		Иначе
			Результат.Добавить(НоваяЧастьРазличий("add", Сред(ПравыйТекст, ИндексПравого, 1)));
			ИндексПравого = ИндексПравого - 1;
		КонецЕсли;
	КонецЦикла;

	Пока ИндексЛевого > 0 Цикл
		Результат.Добавить(НоваяЧастьРазличий("del", Сред(ЛевыйТекст, ИндексЛевого, 1)));
		ИндексЛевого = ИндексЛевого - 1;
	КонецЦикла;
	Пока ИндексПравого > 0 Цикл
		Результат.Добавить(НоваяЧастьРазличий("add", Сред(ПравыйТекст, ИндексПравого, 1)));
		ИндексПравого = ИндексПравого - 1;
	КонецЦикла;

	Возврат ОбратитьМассив(Результат);

КонецФункции

Функция НоваяЧастьРазличий(ТипЧасти, Значение)

	Возврат Новый Структура("type, value", ТипЧасти, Значение);

КонецФункции

Функция РасстояниеЛевенштейна(Левое, Правое)

	ДлинаЛевого = СтрДлина(Левое);
	ДлинаПравого = СтрДлина(Правое);
	Если ДлинаПравого = 0 Тогда
		Возврат ДлинаЛевого;
	КонецЕсли;
	Если ДлинаЛевого = 0 Тогда
		Возврат ДлинаПравого;
	КонецЕсли;

	Предыдущая = Новый Массив;
	Для Индекс = 0 По ДлинаПравого Цикл
		Предыдущая.Добавить(Индекс);
	КонецЦикла;

	Для ИндексЛевого = 1 По ДлинаЛевого Цикл
		Текущая = Новый Массив;
		Текущая.Добавить(ИндексЛевого);
		Для ИндексПравого = 1 По ДлинаПравого Цикл
			Стоимость = ?(Сред(Левое, ИндексЛевого, 1) = Сред(Правое, ИндексПравого, 1), 0, 1);
			Текущая.Добавить(Мин(Текущая[ИндексПравого - 1] + 1, Мин(Предыдущая[ИндексПравого] + 1, Предыдущая[ИндексПравого - 1] + Стоимость)));
		КонецЦикла;
		Предыдущая = Текущая;
	КонецЦикла;

	Возврат Предыдущая[ДлинаПравого];

КонецФункции

Функция ПохожестьТокенов(Левое, Правое)

	ЛевыеТокены = Токены(Левое);
	ПравыеТокены = Токены(Правое);

	Если ЛевыеТокены.Количество() = 0 И ПравыеТокены.Количество() = 0 Тогда
		Возврат 1;
	КонецЕсли;

	Пересечение = 0;
	Для Каждого Токен Из ЛевыеТокены Цикл
		Если ПравыеТокены.Получить(Токен.Ключ) <> Неопределено Тогда
			Пересечение = Пересечение + 1;
		КонецЕсли;
	КонецЦикла;

	Объединение = ЛевыеТокены.Количество() + ПравыеТокены.Количество() - Пересечение;
	Возврат ?(Объединение = 0, 0, Пересечение / Объединение);

КонецФункции

Функция Токены(Текст)

	Результат = Новый Соответствие;
	Текущий = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = НРег(Сред(Текст, Индекс, 1));
		Если ЭтоСимволТокена(Символ) Тогда
			Текущий = Текущий + Символ;
		ИначеЕсли НЕ ПустаяСтрока(Текущий) Тогда
			Результат.Вставить(Текущий, Истина);
			Текущий = "";
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПустаяСтрока(Текущий) Тогда
		Результат.Вставить(Текущий, Истина);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЭтоСимволТокена(Символ)

	Код = КодСимвола(Символ, 1);
	Возврат Символ = "_"
		Или (Код >= КодСимвола("0", 1) И Код <= КодСимвола("9", 1))
		Или (Код >= КодСимвола("a", 1) И Код <= КодСимвола("z", 1))
		Или (Код >= КодСимвола("а", 1) И Код <= КодСимвола("я", 1))
		Или Символ = "ё";

КонецФункции

Функция ИндексыLIS(Последовательность)

	Хвосты = Новый Массив;
	ИндексыХвостов = Новый Массив;
	Предыдущие = Новый Массив;
	Для Индекс = 0 По Последовательность.ВГраница() Цикл
		Предыдущие.Добавить(-1);
	КонецЦикла;

	Для Индекс = 0 По Последовательность.ВГраница() Цикл
		Значение = Последовательность[Индекс];
		Позиция = НижняяГраница(Хвосты, Значение);
		Если Позиция > 0 Тогда
			Предыдущие[Индекс] = ИндексыХвостов[Позиция - 1];
		КонецЕсли;
		УстановитьЭлементМассива(Хвосты, Позиция, Значение);
		УстановитьЭлементМассива(ИндексыХвостов, Позиция, Индекс);
	КонецЦикла;

	Результат = Новый Соответствие;
	Если ИндексыХвостов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Индекс = ИндексыХвостов[ИндексыХвостов.ВГраница()];
	Пока Индекс <> -1 Цикл
		Результат.Вставить(Индекс, Истина);
		Индекс = Предыдущие[Индекс];
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НижняяГраница(Список, Значение)

	Низ = 0;
	Верх = Список.Количество();
	Пока Низ < Верх Цикл
		Середина = Цел((Низ + Верх) / 2);
		Если Список[Середина] < Значение Тогда
			Низ = Середина + 1;
		Иначе
			Верх = Середина;
		КонецЕсли;
	КонецЦикла;
	Возврат Низ;

КонецФункции

Процедура УстановитьЭлементМассива(МассивЗначений, Индекс, Значение)

	Если Индекс <= МассивЗначений.ВГраница() Тогда
		МассивЗначений[Индекс] = Значение;
	Иначе
		МассивЗначений.Добавить(Значение);
	КонецЕсли;

