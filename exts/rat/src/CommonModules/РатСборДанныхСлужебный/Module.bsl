#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// см. РатСборДанных.ИспользуетсяСборДанных
Функция ИспользуетсяСборДанных() Экспорт

	Попытка

		Возврат ЭтоАдресВременногоХранилища(ПараметрыСеанса.РатАдресВременногоКонтекста);

	Исключение

		// Ошибка возникает при подключении в безопасном режиме
		Возврат Ложь; // TODO: Не отрабатывает установка параметра из расширения

	КонецПопытки;

КонецФункции

// см. РатСборДанных.ИнициализироватьСборДанных
Функция ИнициализироватьСборДанных() Экспорт

	АдресХранилища = ПоместитьВоВременноеХранилище(НовыйКонтекст(), Новый УникальныйИдентификатор());
	ПараметрыСеанса.РатАдресВременногоКонтекста = АдресХранилища;

	Возврат АдресХранилища;

КонецФункции

// см. РатСборДанных.ОстановитьСборДанных
Процедура ОстановитьСборДанных() Экспорт

	ПараметрыСеанса.РатАдресВременногоКонтекста = "";

КонецПроцедуры

// см. РатСборДанных.ОстановитьСборДанныхИПолучитьЗаписи
Функция ОстановитьСборДанныхИПолучитьЗаписи() Экспорт

	Контекст = Контекст();

	УдалитьИзВременногоХранилища(ПараметрыСеанса.РатАдресВременногоКонтекста);
	ПараметрыСеанса.РатАдресВременногоКонтекста = "";

	ДанныеВерсий = Новый Массив;
	ПредидущиеВерсии = Новый Соответствие();
	Записи = Новый Массив;

	Для Каждого Элемент Из Контекст.ПервоначальныеВерсии Цикл

		Если ЗначениеЗаполнено(Элемент.Значение) Тогда
			ДанныеВерсий.Добавить(Элемент.Значение);
			ПредидущиеВерсии.Вставить(Элемент.Ключ, ДанныеВерсий.ВГраница());
		КонецЕсли;

	КонецЦикла;

	Для Каждого Запись Из Контекст.Записи Цикл

		ДанныеВерсий.Добавить(Запись.Данные);
		ТекущаяВерсия = ДанныеВерсий.ВГраница();

		ПредидущаяВерсия = ПредидущиеВерсии.Получить(Запись.Ключ);
		ПредидущиеВерсии.Вставить(Запись.Ключ, ТекущаяВерсия);

		ДанныеЗаписи = РатСборДанных.НовоеОписаниеЗаписи();
		ДанныеЗаписи.ИндексВерсии = ТекущаяВерсия;
		ДанныеЗаписи.ИндексПрошлойВерсии = ПредидущаяВерсия;
		ДанныеЗаписи.Тип = Запись.Тип;
		ДанныеЗаписи.Представление = Запись.Представление;
		ДанныеЗаписи.Ключ = Запись.Ключ;
		ДанныеЗаписи.Время = Запись.Время;
		ДанныеЗаписи.Стек = Запись.Стек;

		Записи.Добавить(ДанныеЗаписи);

	КонецЦикла;

	Возврат Новый Структура("ДанныеВерсий, Записи", ДанныеВерсий, Записи);

КонецФункции

Процедура ЗафиксироватьПервоначальнуюВерсию(Источник, Замещение = Неопределено) Экспорт

	Контекст = Контекст();

	Ключ = КлючЗаписи(Источник);
	Если ЗначениеЗаполнено(Ключ) И Контекст.ПервоначальныеВерсии[Ключ] = Неопределено Тогда

		Данные = ДанныеПервоначальнойВерсии(Источник);
		Контекст.ПервоначальныеВерсии.Вставить(Ключ, Данные);

		СохранитьКонтекст(Контекст);

	КонецЕсли;

КонецПроцедуры

Процедура ЗафиксироватьЗаписьОбъекта(Источник) Экспорт

	Контекст = Контекст();

	Запись = НовоеОписаниеЗаписи();
	Запись.Ключ = КлючЗаписи(Источник);
	Запись.Данные = СериализоватьДанныеВерсии(ДанныеВерсии(Источник));
	Запись.Тип = ТипЗнч(Источник);
	Запись.Представление = ПредставлениеЗаписи(Источник);
	Запись.Стек = ПолучитьСтек();
	Запись.Время = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Контекст.Записи.Добавить(Запись);

	Если Контекст.ПервоначальныеВерсии.Получить(Запись.Ключ) = Неопределено Тогда
		Контекст.ПервоначальныеВерсии.Вставить(Запись.Ключ, "");
	КонецЕсли;

	СохранитьКонтекст(Контекст);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовоеОписаниеЗаписи()

	Описание = Новый Структура;
	Описание.Вставить("Ключ");
	Описание.Вставить("Данные");
	Описание.Вставить("Тип");
	Описание.Вставить("Представление");
	Описание.Вставить("Стек");
	Описание.Вставить("Время");

	Возврат Описание;

КонецФункции

// Новый контекст.
//
// Возвращаемое значение:
//  Структура - Новый контекст:
// * Записи - Массив из см. НовоеОписаниеЗаписи
// * ВремяНачала - Число
// * ВремяОкончания - Число
// * ПервоначальныеВерсии - Соответствие из Произвольный
Функция НовыйКонтекст()

	Контекст = Новый Структура;
	Контекст.Вставить("Записи", Новый Массив);
	Контекст.Вставить("ВремяНачала", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Контекст.Вставить("ВремяОкончания", 0);
	Контекст.Вставить("ПервоначальныеВерсии", Новый Соответствие);

	Возврат Контекст;

КонецФункции

Процедура СохранитьКонтекст(Контекст)

	ПоместитьВоВременноеХранилище(Контекст, ПараметрыСеанса.РатАдресВременногоКонтекста);

КонецПроцедуры

// Контекст.
//
// Возвращаемое значение:
//  см. НовыйКонтекст
Функция Контекст()

	АдресХранилища = ПараметрыСеанса.РатАдресВременногоКонтекста;

	Если НЕ ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		ВызватьИсключение "Использование функциональности сбора данных до инициализации";
	КонецЕсли;

	Возврат ПолучитьИзВременногоХранилища(АдресХранилища);

КонецФункции

Функция ДанныеВерсии(Объект)

	Если ЭтоМенеджерЗначенияКонстанты(Объект) Тогда
		Возврат ДанныеВерсииКонстанты(Объект);
	КонецЕсли;

	Возврат Объект;

КонецФункции

Функция ДанныеПервоначальнойВерсии(Источник)

	Если ЭтоМенеджерЗначенияКонстанты(Источник) Тогда
		Возврат СериализоватьДанныеВерсии(ДанныеВерсииКонстанты(Источник));
	КонецЕсли;

	ТипИсточника = ТипЗнч(Источник);
	Если РатТипыДанных.ЭтоТипНабораЗаписей(ТипИсточника) Тогда
		Если НЕ ЗначениеЗаполнено(Источник.Отбор) Тогда
			Возврат "";
		КонецЕсли;

		Объект = Новый (ТипЗнч(Источник));
		Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
			Объект.Отбор[ЭлементОтбора.Имя].Установить(ЭлементОтбора.Значение);
		КонецЦикла;

		Объект.Прочитать();
	Иначе
		Объект = Источник.Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Возврат СериализоватьОбъект(Объект);

КонецФункции

Функция СериализоватьДанныеВерсии(Данные)

	Если ЭтоДанныеВерсииКонстанты(Данные) Тогда
		Возврат СериализоватьКонстанту(Данные);
	КонецЕсли;

	Возврат СериализоватьОбъект(Данные);

КонецФункции

Функция СериализоватьОбъект(Объект)

	МетаданныеТаблицы = РатМетаданные.МетаданныеТаблицы(Объект.Метаданные().ПолноеИмя(), РатОбщий.НовыйСтатусОбработкиЗапроса());

	Если НЕ МетаданныеТаблицы.ЭтоРегистр Тогда
		Данные = СериализоватьШапку(Объект, МетаданныеТаблицы.Реквизиты);

		Для Каждого Таблица Из МетаданныеТаблицы.ТабличныеЧасти Цикл
			ДанныеТаблицы = СериализоватьТаблицу(Объект[Таблица.Ключ], Таблица.Значение.Реквизиты);
			ДанныеТаблицы.Вставить("name", Таблица.Значение.Представление);
			Данные.fields.Вставить(Таблица.Ключ, ДанныеТаблицы);
		КонецЦикла;
	Иначе
		Данные = СериализоватьТаблицу(Объект, МетаданныеТаблицы.Реквизиты);
		Данные.Вставить("name", Строка(Объект));
	КонецЕсли;

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Функция СериализоватьКонстанту(Данные)

	Результат = Новый Структура("type, fields", "structure", Новый Соответствие);
	Результат.Вставить("name", Данные.Представление);
	Результат.fields.Вставить("Значение", Строка(Данные.Значение));

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Результат);
	Возврат Запись.Закрыть();

КонецФункции

Функция СериализоватьШапку(Данные, Реквизиты)

	Результат = Новый Структура("type, fields", "structure", Новый Соответствие);

	Для Каждого Реквизит Из Реквизиты Цикл
		Результат.fields.Вставить(Реквизит.Представление, Строка(Данные[Реквизит.Имя]));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СериализоватьТаблицу(Данные, Колонки)

	Результат = Новый Структура("type", "table");
	Результат.Вставить("columns", РатКоллекции.ВыгрузитьЗначения(Колонки, "Представление"));
	Результат.Вставить("rows", Новый Массив);

	Для Каждого Строка Из Данные Цикл
		Запись = Новый Соответствие;
		Для Каждого Реквизит Из Колонки Цикл
			Запись.Вставить(Реквизит.Представление, Строка(Строка[Реквизит.Имя]));
		КонецЦикла;
		Результат.rows.Добавить(Новый Структура("id, cells", Строка.НомерСтроки, Запись));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьСтек()

	Попытка
		Результат = 1/0;
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	Стек = Новый Массив;

	ПредставлениеОшибки = ПодробноеПредставлениеОшибки(Ошибка);
	Для Каждого Строка Из СтрРазделить(ПредставлениеОшибки, Символы.ПС) Цикл

		Если СтрНачинаетсяС(Строка, "{") И НЕ СтрНачинаетсяС(Строка, "{RAT ОбщийМодуль.РатСборДанных") Тогда
			Стек.Добавить(Строка);
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Стек, Символы.ПС);

КонецФункции

Функция КлючЗаписи(Объект)

	Если ЭтоМенеджерЗначенияКонстанты(Объект) Тогда

		Ключ = Объект.Метаданные().ПолноеИмя();

	ИначеЕсли РатТипыДанных.ЭтоТипНабораЗаписей(ТипЗнч(Объект)) Тогда

		Ключ = Новый Массив;
		Ключ.Добавить(ТипЗнч(Объект));

		Для Каждого ЭлементОтбора Из Объект.Отбор Цикл
			Ключ.Добавить(ЭлементОтбора.Имя);
			Ключ.Добавить(ЭлементОтбора.Значение);
		КонецЦикла;

		Ключ = ЗначениеВСтрокуВнутр(Ключ);

	ИначеЕсли ЗначениеЗаполнено(Объект.Ссылка)Тогда

		Ключ = Объект.Ссылка;

	КонецЕсли;

	Возврат Ключ;

КонецФункции

Функция ПредставлениеЗаписи(Объект)

	Если ЭтоМенеджерЗначенияКонстанты(Объект) Тогда
		Возврат Объект.Метаданные().Представление();
	КонецЕсли;

	Возврат Строка(Объект);

КонецФункции

Функция ДанныеВерсииКонстанты(МенеджерЗначения)

	ИмяКонстанты = МенеджерЗначения.Метаданные().Имя;

	Данные = Новый Структура;
	Данные.Вставить("ЭтоКонстанта", Истина);
	Данные.Вставить("Имя", МенеджерЗначения.Метаданные().ПолноеИмя());
	Данные.Вставить("Представление", МенеджерЗначения.Метаданные().Представление());
	Данные.Вставить("Значение", Константы[ИмяКонстанты].Получить());

	Возврат Данные;

КонецФункции

Функция ЭтоДанныеВерсииКонстанты(Данные)

	ЭтоКонстанта = Ложь;
	Возврат ТипЗнч(Данные) = Тип("Структура")
		И Данные.Свойство("ЭтоКонстанта", ЭтоКонстанта)
		И ЭтоКонстанта;

КонецФункции

Функция ЭтоМенеджерЗначенияКонстанты(Объект)

	Попытка
		Возврат СтрНачинаетсяС(Объект.Метаданные().ПолноеИмя(), "Константа.");
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

#КонецЕсли
