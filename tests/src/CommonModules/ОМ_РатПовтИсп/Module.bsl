#Область СлужебныйПрограммныйИнтерфейс

// Регистрация тестовых методов
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ВТранзакции()
		.ДобавитьТест("КлючСистемногоПеречисления")
			.СПараметрами("ВидДвиженияНакопления", "Приход", "Приход")
			.СПараметрами("ВидДвиженияНакопления", "Расход", "Расход")
			.СПараметрами("СостояниеФоновогоЗадания", "Завершено аварийно", "ЗавершеноАварийно")
			.СПараметрами("ВидДвиженияНакопления", "НачалоВчерашнегоДня", "НачалоВчерашнегоДня")
			.СПараметрами("ВидДвиженияНакопления", "Начало Вчерашнего Дня", "НачалоВчерашнегоДня");

КонецПроцедуры

#КонецОбласти

#Область Тесты_КлючСистемногоПеречисления

// Тест получения ключа значения системного перечисления по представлению.
// Если представление совпадает с представлением элемента перечисления, возвращается ключ элемента.
// Если представление не совпадает ни с одним элементом перечисления, возвращается
// идентификатор, полученный из представления (исключение не вызывается).
//
// Параметры:
//   ИмяПеречисления - Строка - имя системного перечисления
//   ПредставленияЗначения - Строка - представление значения
//   ОжидаемыйКлюч - Строка - ожидаемый ключ
//
Процедура КлючСистемногоПеречисления(ИмяПеречисления, ПредставленияЗначения, ОжидаемыйКлюч) Экспорт

	// Act
	Ключ = РатПовтИсп.КлючСистемногоПеречисления(ИмяПеречисления, ПредставленияЗначения);

	// Assert
	ЮТест.ОжидаетЧто(Ключ, "Ключ системного перечисления").Равно(ОжидаемыйКлюч);

КонецПроцедуры

#КонецОбласти
