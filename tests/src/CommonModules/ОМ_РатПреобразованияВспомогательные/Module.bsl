#Область СлужебныйПрограммныйИнтерфейс

// Регистрация тестовых методов
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции()
		// ИзвлечьТипИЗначение
		.ДобавитьТест("ИзвлечьТипИЗначение")
			.Настроить(ПараметрыДляИзвлечьТипИЗначение())
		
		// ТипЗначенияПоПредставлению
		.ДобавитьТест("ТипЗначенияПоПредставлению_ТипСправочника")
		.ДобавитьТест("ТипЗначенияПоПредставлению_ТипДокумента")
		.ДобавитьТест("ТипЗначенияПоПредставлению_ПримитивныйТип")
			.СПараметрами("string", Тип("Строка"), Истина).Представление("Строка", Истина)
			.СПараметрами("decimal", Тип("Число"), Истина).Представление("Число", Истина)
			.СПараметрами("boolean", Тип("Булево"), Истина).Представление("Булево", Истина)
			.СПараметрами("dateTime", Тип("Дата"), Истина).Представление("ДатаВремя", Истина)
		.ДобавитьТест("ТипЗначенияПоПредставлению_НесуществующийТип")
		
		// ПараметрыДесериализации
		.ДобавитьТест("ПараметрыДесериализации_ОдинТип")
		.ДобавитьТест("ПараметрыДесериализации_СоставнойТип")
		.ДобавитьТест("ПараметрыДесериализации_ТипизированнаяСтрока")
		.ДобавитьТест("ПараметрыДесериализации_Выражение")
		
		// ДесериализоватьТипизированноеЗначение
		.ДобавитьТест("ДесериализоватьТипизированноеЗначение_СправочникСтрока")
		.ДобавитьТест("ДесериализоватьТипизированноеЗначение_СправочникСтруктура")
		.ДобавитьТест("ДесериализоватьТипизированноеЗначение_ПримитивСтрока")
		.ДобавитьТест("ДесериализоватьТипизированноеЗначение_БезТипа")
		
		// ДесериализоватьПроизвольноеЗначение
		.ДобавитьТест("ДесериализоватьПроизвольноеЗначение_Примитив")
		.ДобавитьТест("ДесериализоватьПроизвольноеЗначение_Типизированное")
		.ДобавитьТест("ДесериализоватьПроизвольноеЗначение_Структура")
		.ДобавитьТест("ДесериализоватьПроизвольноеЗначение_Массив")
		.ДобавитьТест("ДесериализоватьПроизвольноеЗначение_ВложеннаяСтруктура")
		
		// ЗагрузитьТаблицуMarkDown
		.ДобавитьТест("ЗагрузитьТаблицуMarkDown_ПростаяТаблица")
		.ДобавитьТест("ЗагрузитьТаблицуMarkDown_ТаблицаСНачальнойСтроки")
		.ДобавитьТест("ЗагрузитьТаблицуMarkDown_ТаблицаСПробелами")
	
КонецПроцедуры

#КонецОбласти

#Область ИзвлечьТипИЗначение

// Тестирует извлечение типа и значения из структуры с type и id.
//
// Параметры:
//   ВходноеЗначение - Произвольный - исходное значение
//   ОжидаемыйТип - Произвольный - ожидаемое представление типа
//   ОжидаемоеЗначение - Произвольный - ожидаемое значение после извлечения
//   ОжидаемаяТипизированнаяСтрока - Булево - признак типизированной строки
Процедура ИзвлечьТипИЗначение(ВходноеЗначение, ОжидаемыйТип, ОжидаемоеЗначение, ОжидаемаяТипизированнаяСтрока) Экспорт
	// Act
	Результат = РатПреобразованияВспомогательные.ИзвлечьТипИЗначение(ВходноеЗначение);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат)
		.Свойство("ПредставлениеТипа").Равно(ОжидаемыйТип)
		.Свойство("Значение").Равно(ОжидаемоеЗначение)
		.Свойство("ЭтоТипизированнаяСтрока").Равно(ОжидаемаяТипизированнаяСтрока);
КонецПроцедуры

#КонецОбласти

