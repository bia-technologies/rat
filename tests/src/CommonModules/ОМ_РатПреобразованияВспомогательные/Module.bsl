	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Создаем тестовый справочник (используем доступный в фикстурах объект)
	Номенклатура = ЮТест.Данные().КонструкторОбъекта("Справочник.Ф_Номенклатура")
		.ФикцияОбязательныхПолей()
		.Записать();
	
	УИД = Строка(Номенклатура.УникальныйИдентификатор());
	Значение = Новый Структура("type, id", "CatalogRef.Ф_Номенклатура", УИД);
	
	// Act
	Результат = РатПреобразованияВспомогательные.ДесериализоватьТипизированноеЗначение(Значение, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат десериализации")
		.ИмеетТип("СправочникСсылка.Ф_Номенклатура")
		.Равно(Номенклатура);
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус выполнения").ЭтоИстина();
