#Область ДесериализоватьТипизированноеЗначение

Процедура ДесериализоватьТипизированноеЗначение_СправочникСтрока() Экспорт
	// Arrange
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Создаем тестовый справочник
	Ссылка = ЮТест.Данные().КонструкторОбъекта("Справочник.Ф_Номенклатура")
		.ФикцияОбязательныхПолей()
		.Записать();
	
	УИД = Ссылка.УникальныйИдентификатор();
	Значение = СтрШаблон("CatalogRef.Ф_Номенклатура.%1", УИД);
	
	// Act
	Результат = РатПреобразованияВспомогательные.ДесериализоватьТипизированноеЗначение(Значение, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат десериализации")
		.ИмеетТип("СправочникСсылка.Ф_Номенклатура")
		.Равно(Ссылка);
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус выполнения").ЭтоИстина();
КонецПроцедуры

Процедура ДесериализоватьТипизированноеЗначение_СправочникСтруктура() Экспорт
