#Область ЗагрузитьТаблицуMarkDown

Процедура ЗагрузитьТаблицуMarkDown_ПростаяТаблица() Экспорт
	// Arrange
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.ДобавитьСтроку("| Колонка1 | Колонка2 | Колонка3 |");
	ТекстовыйДокумент.ДобавитьСтроку("|----------|----------|----------|");
	ТекстовыйДокумент.ДобавитьСтроку("| Значение1 | Значение2 | Значение3 |");
	ТекстовыйДокумент.ДобавитьСтроку("| Значение4 | Значение5 | Значение6 |");
	
	// Act
	Результат = РатПреобразованияВспомогательные.ЗагрузитьТаблицуMarkDown(ТекстовыйДокумент);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Загруженная таблица")
		.ИмеетТип("ТаблицаЗначений")
		.ИмеетДлину(2)
		.Свойство("Колонки").ИмеетДлину(3)
		.Свойство("[0].Колонка1").Равно("Значение1")
		.Свойство("[0].Колонка2").Равно("Значение2")
		.Свойство("[1].Колонка3").Равно("Значение6");
КонецПроцедуры

Процедура ЗагрузитьТаблицуMarkDown_ТаблицаСНачальнойСтроки() Экспорт
	// Arrange
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.ДобавитьСтроку("Заголовок документа");
	ТекстовыйДокумент.ДобавитьСтроку("");
	ТекстовыйДокумент.ДобавитьСтроку("| Колонка1 | Колонка2 |");
	ТекстовыйДокумент.ДобавитьСтроку("|----------|----------|");
	ТекстовыйДокумент.ДобавитьСтроку("| Значение1 | Значение2 |");
	
	// Act
	Результат = РатПреобразованияВспомогательные.ЗагрузитьТаблицуMarkDown(ТекстовыйДокумент, 3);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Загруженная таблица")
		.ИмеетДлину(1)
		.Свойство("Колонки").ИмеетДлину(2)
		.Свойство("[0].Колонка1").Равно("Значение1");
КонецПроцедуры

