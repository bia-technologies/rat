Функция ПараметрыДляИзвлечьТипИЗначение()
	УИД = Новый УникальныйИдентификатор();
	
	// Структура с type и id
	ЮТТесты.СПараметрами(
		Новый Структура("type, id", "Catalog.Контрагенты", "123"),
		"Catalog.Контрагенты",
		"123",
		Ложь).Представление("Структура с type и id");
	
	// Структура с type и value
	ЮТТесты.СПараметрами(
		Новый Структура("type, value", "string", "ТестоваяСтрока"),
		"string",
		"ТестоваяСтрока",
		Ложь).Представление("Структура с type и value");
	
	// Строка примитив
	ЮТТесты.СПараметрами(
		"string.ТестоваяСтрока",
		"string",
		"ТестоваяСтрока",
		Истина).Представление("Строка примитив");
	
	// Строка ссылка
	ЮТТесты.СПараметрами(
		СтрШаблон("Справочник.Контрагенты.%1", УИД),
		"Справочник.Контрагенты",
		Строка(УИД),
		Истина).Представление("Строка ссылка");
	
	// Строка без типа
	ЮТТесты.СПараметрами(
		"ПростаяСтрока",
		Неопределено,
		"ПростаяСтрока",
		Ложь).Представление("Строка без типа");
	Возврат Неопределено;
КонецФункции

#КонецОбласти
