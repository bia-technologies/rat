		.Элемент(1).Равно("Значение2")
		.Элемент(2).Равно(123);
	
КонецПроцедуры

// Тест сериализации таблицы значений
Процедура СериализоватьЗначение_ТаблицаЗначений() Экспорт
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Колонка1", Новый ОписаниеТипов("Строка"));
	ТаблицаЗначений.Колонки.Добавить("Колонка2", Новый ОписаниеТипов("Число"));
	
	НоваяСтрока = ТаблицаЗначений.Добавить();
	НоваяСтрока.Колонка1 = "Значение1";
	НоваяСтрока.Колонка2 = 100;
	
	НоваяСтрока = ТаблицаЗначений.Добавить();
	НоваяСтрока.Колонка1 = "Значение2";
	НоваяСтрока.Колонка2 = 200;
	
	Результат = РатПреобразования.СериализоватьЗначение(ТаблицаЗначений);
	
	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Массив")
		.ИмеетДлину(2);
	
	ЮТест.ОжидаетЧто(Результат[0])
		.ИмеетТип("Структура")
		.Свойство("Колонка1").Равно("Значение1")
		.Свойство("Колонка2").Равно(100);
	
КонецПроцедуры

