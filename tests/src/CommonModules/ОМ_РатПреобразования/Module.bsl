// Тест сериализации хранилища значения с двоичными данными
Процедура СериализоватьЗначение_ХранилищеЗначения_Base64() Экспорт
	
	БазовоеЗначение = "Test";
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(БазовоеЗначение, КодировкаТекста.UTF8);
	ХранилищеЗначения = Новый ХранилищеЗначения(ДвоичныеДанные);
	
	Результат = РатПреобразования.СериализоватьЗначение(ХранилищеЗначения);
	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Структура")
		.Свойство("type").Равно("base64Binary")
		.Свойство("value").Равно("VGVzdA==");
	
КонецПроцедуры

// Тест сериализации списка значений
Процедура СериализоватьЗначение_СписокЗначений() Экспорт
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Значение1");
	СписокЗначений.Добавить("Значение2");
	СписокЗначений.Добавить(123);
	
	Результат = РатПреобразования.СериализоватьЗначение(СписокЗначений);
	
	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Массив")
		.ИмеетДлину(3)
