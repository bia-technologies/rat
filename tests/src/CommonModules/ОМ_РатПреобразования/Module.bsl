// Тест загрузки таблицы Markdown
Процедура ЗагрузитьТаблицуMarkDown() Экспорт
	
	ТекстДокумент = Новый ТекстовыйДокумент;
	ТекстДокумент.ДобавитьСтроку("| Колонка1 | Колонка2 | Колонка3 |");
	ТекстДокумент.ДобавитьСтроку("|----------|----------|----------|");
	ТекстДокумент.ДобавитьСтроку("| Значение1 | Значение2 | Значение3 |");
	ТекстДокумент.ДобавитьСтроку("| Значение4 | Значение5 | Значение6 |");
	
	Результат = РатПреобразования.ЗагрузитьТаблицуMarkDown(ТекстДокумент);
	
	ЮТест.ОжидаетЧто(Результат)
