#Область СлужебныйПрограммныйИнтерфейс

// Регистрирует тестовые сценарии для модуля РатПреобразования
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТест("СериализоватьЗначение_ПримитивныеТипы")
			.СПараметрами("Тест", "Тест")             // Строка
			.СПараметрами(123.45, 123.45)             // Число
			.СПараметрами(Истина, Истина)             // Булево истина
			.СПараметрами(Ложь, Ложь)                 // Булево ложь
			.СПараметрами(Неопределено, Неопределено) // Неопределено
		.ДобавитьТест("СериализоватьЗначение_Дата")
			.СПараметрами('20240101120000', "2024-01-01T12:00:00")  // Полная дата
			.СПараметрами('20240315', "2024-03-15T00:00:00")        // Только дата
		.ДобавитьТест("СериализоватьЗначение_УникальныйИдентификатор")
		.ДобавитьТест("СериализоватьЗначение_Массив")
		.ДобавитьТест("СериализоватьЗначение_Структура")
		.ДобавитьТест("СериализоватьЗначение_ХранилищеЗначения")
		.ДобавитьТест("СериализоватьЗначение_ХранилищеЗначения_Base64")
		.ДобавитьТест("СериализоватьЗначение_СписокЗначений")
		.ДобавитьТест("СериализоватьЗначение_ТаблицаЗначений")
		.ДобавитьТест("СериализоватьЗначение_Соответствие")
		.ДобавитьТест("СериализоватьЗначение_СистемноеПеречисление")
		.ДобавитьТест("СериализоватьЗначение_СсылочныйТип")
		.ДобавитьТест("СериализоватьЗначение_КлючЗаписи")
		.ДобавитьТест("СериализоватьЗначение_ДвоичныеДанные")
		.ДобавитьТест("ДесериализоватьЗначение_ПримитивныеТипы")
		.ДобавитьТест("ДесериализоватьЗначение_Дата")
			.СПараметрами("2024-01-01T12:00:00", '20240101120000')  // Полная дата
			.СПараметрами("2024-03-15", '20240315')                 // Только дата
		.ДобавитьТест("ДесериализоватьЗначение_Булево")
			.СПараметрами(Истина, Истина)   // Истина
			.СПараметрами(Ложь, Ложь)       // Ложь
		.ДобавитьТест("ДесериализоватьЗначение_Число")
			.СПараметрами("123", 123)       // Целое число
			.СПараметрами("123.45", 123.45) // Дробное число
		.ДобавитьТест("ДесериализоватьЗначение_УникальныйИдентификатор")
		.ДобавитьТест("ДесериализоватьЗначение_ОшибкиНекорректныхДанных")
		.ДобавитьТест("ДесериализоватьЗначение_СсылочныйТип").ВТранзакции()
		.ДобавитьТест("ДесериализоватьЗначение_СистемноеПеречисление")
		.ДобавитьТест("ДесериализоватьЗначение_КлючЗаписи")
		.ДобавитьТест("ДесериализоватьЗначение_ХранилищеЗначения")
		.ДобавитьТест("ДесериализоватьЗначение_ХранилищеЗначения_Base64")
		.ДобавитьТест("ДесериализоватьМассивЗначений")
		.ДобавитьТест("ДесериализоватьТипизированноеЗначение")
		.ДобавитьТест("ДесериализоватьТипизированноеЗначение_ДвоичныеДанные")
		.ДобавитьТест("ДесериализоватьТипизированноеЗначение_ХранилищеЗначения")
		.ДобавитьТест("ДесериализоватьПроизвольноеЗначение")
		.ДобавитьТест("ОписаниеРеквизита")
		.ДобавитьТест("ОписаниеКоллекции")
		.ДобавитьТест("ОписаниеРеквизитовОбъектаМетаданных")
		.ДобавитьТест("ПреобразоватьДанные")
		.ДобавитьТест("ПреобразоватьДанные_ОшибкиВалидации")
		.ДобавитьТест("ЗагрузитьТаблицуMarkDown")
		.ДобавитьТест("ЗагрузитьТаблицуMarkDown_НекорректныйФормат")
		.ДобавитьТест("ИмяЭлементаПеречисления")
			.СПараметрами(ВидДвиженияНакопления.Приход, "Receipt")   // Перечисление накопления
			.СПараметрами(ВидДвиженияБухгалтерии.Дебет, "Debit")     // Перечисление бухгалтерии
		.ДобавитьТест("ИмяСистемногоПеречисления")
		.ДобавитьТест("МенеджерСистемногоПеречисления")
		.ДобавитьТест("КлючСистемногоПеречисления")
		.ДобавитьТест("ЗначениеСистемногоПеречисления")
		.ДобавитьТест("ЗначенияИдентификатора")
		.ДобавитьТест("ЗначенияИдентификатора_НекорректныйФормат")
		.ДобавитьТест("СериализоватьРеквизитСоставногоТипа")
			.СПараметрами("Тестовая строка", Новый Структура("type, id", "string", "Тестовая строка")) // Строка
			.СПараметрами(123.45, Новый Структура("type, id", "decimal", 123.45))                      // Число
		.ДобавитьТест("СериализоватьРеквизитСоставногоТипа_Неопределено")
		.ДобавитьТест("ИзвлечьТипИЗначение")
		.ДобавитьТест("ЗначениеВБулево")
			.СПараметрами(Истина, Истина)   // Булево истина
			.СПараметрами(Ложь, Ложь)       // Булево ложь
			.СПараметрами("true", Истина)   // Строка "true"
			.СПараметрами(1, Истина)        // Число 1
			.СПараметрами(0, Ложь)          // Число 0
		.ДобавитьТест("ЗначениеВБулево_НекорректныеДанные")
		.ДобавитьТест("ДанныеСохраняемогоОбъекта").ВТранзакции()
		.ДобавитьТест("ИдентификаторЗаписи").ВТранзакции()
		.ДобавитьТест("РеквизитыИзТела")
		.ДобавитьТест("ГраничныеСлучаи_ПустыеКоллекции")
		.ДобавитьТест("ГраничныеСлучаи_NullЗначения")
		.ДобавитьТест("Сложные_Вложенные_Структуры")
		.ДобавитьТест("СоставныеТипы_Комбинации")
	;
	
КонецПроцедуры

#Область ТестыСериализации

// Тест сериализации примитивных типов
//
// Параметры:
//   ВходноеЗначение - Произвольный - тестируемое значение
//   ОжидаемыйРезультат - Произвольный - ожидаемый результат сериализации
//
Процедура СериализоватьЗначение_ПримитивныеТипы(ВходноеЗначение, ОжидаемыйРезультат) Экспорт
	
	Результат = РатПреобразования.СериализоватьЗначение(ВходноеЗначение);
	ЮТест.ОжидаетЧто(Результат).Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

// Тест сериализации даты
//
// Параметры:
//   ВходнаяДата - Дата - тестируемая дата
//   ОжидаемыйРезультат - Строка - ожидаемый результат сериализации
//
Процедура СериализоватьЗначение_Дата(ВходнаяДата, ОжидаемыйРезультат) Экспорт
	
	Результат = РатПреобразования.СериализоватьЗначение(ВходнаяДата);
	ЮТест.ОжидаетЧто(Результат).Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

// Тест сериализации УникальныйИдентификатор
Процедура СериализоватьЗначение_УникальныйИдентификатор() Экспорт
	
	УИД = Новый УникальныйИдентификатор("12345678-1234-1234-1234-123456789012");
	Результат = РатПреобразования.СериализоватьЗначение(УИД);
	ЮТест.ОжидаетЧто(Результат).Равно("12345678-1234-1234-1234-123456789012");
	
КонецПроцедуры

// Тест сериализации массива
Процедура СериализоватьЗначение_Массив() Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить("строка");
	Массив.Добавить(42);
	Массив.Добавить(Истина);
	
	Результат = РатПреобразования.СериализоватьЗначение(Массив);
	
	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Массив")
		.ИмеетДлину(3)
		.Элемент(0).Равно("строка")
		.Элемент(1).Равно(42)
		.Элемент(2).Равно(Истина);
	
КонецПроцедуры

// Тест сериализации структуры
Процедура СериализоватьЗначение_Структура() Экспорт
	
	Структура = Новый Структура;
	Структура.Вставить("Поле1", "Значение1");
	Структура.Вставить("Поле2", 123);
	
	Результат = РатПреобразования.СериализоватьЗначение(Структура);
	
	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Структура")
		.Свойство("Поле1").Равно("Значение1")
		.Свойство("Поле2").Равно(123);
	
КонецПроцедуры

