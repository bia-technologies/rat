// Тест сериализации ссылочного типа
Процедура СериализоватьЗначение_СсылочныйТип() Экспорт
	
	// Тест с пустой ссылкой
	ПустаяСсылка = Справочники.ПУБ_Номенклатура.ПустаяСсылка();
	Результат = РатПреобразования.СериализоватьЗначение(ПустаяСсылка);
	
	ОжидаемоеПредставление = Строка(ПустаяСсылка);
	
	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Структура")
		.Свойство("type").НеРавно("")
		.Свойство("id").Равно("")
		.Свойство("presentation").Равно(ОжидаемоеПредставление);
	
КонецПроцедуры

// Тест сериализации ключа записи
Процедура СериализоватьЗначение_КлючЗаписи() Экспорт
	
	// Создаем структуру со значениями измерений
	ЗначенияКлюча = Новый Структура;
	ЗначенияКлюча.Вставить("Число", 1);
	ЗначенияКлюча.Вставить("Строка", "Тест");
	ЗначенияКлюча.Вставить("Дата", ТекущаяДатаСеанса());
	
	// Создаем ключ записи регистра сведений
	КлючЗаписи = РегистрыСведений.ПУБ_ПримитивныеИзмерения.СоздатьКлючЗаписи(ЗначенияКлюча);
	Результат = РатПреобразования.СериализоватьЗначение(КлючЗаписи);
	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Структура");
	
КонецПроцедуры

#КонецОбласти

#Область ТестыДесериализации

// Тест десериализации примитивных типов
Процедура ДесериализоватьЗначение_ПримитивныеТипы() Экспорт
	
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Строка
	Результат = РатПреобразования.ДесериализоватьЗначение("Тест", Тип("Строка"), СтатусОбработкиЗапроса, "тест строки");
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат).Равно("Тест");
	
	// Неопределено
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	Результат = РатПреобразования.ДесериализоватьЗначение(Неопределено, Тип("Строка"), СтатусОбработкиЗапроса, "тест неопределено");
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат).Равно("");
	
КонецПроцедуры

