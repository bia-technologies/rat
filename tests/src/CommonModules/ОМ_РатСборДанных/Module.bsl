#Область СлужебныеПроцедурыИФункции

Процедура ПроверкаЗаписиОбъекта(Ссылка, Тип)
	
	Записи = РатСборДанных.ОстановитьСборДанныхИПолучитьЗаписи();
	
	ЮТест.ОжидаетЧто(Записи)
		.ИмеетДлину(1)
		.Элемент("[0].Данные")
			.ИмеетТип(Тип)
			.Свойство("[0].Данные.Ссылка").Равно(Ссылка)
	;
КонецПроцедуры

#КонецОбласти
