#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТест("ИспользуетсяСборДанных_БезИнициализации")
		.ДобавитьТест("ИспользуетсяСборДанных_ПослеИнициализации")
		.ДобавитьТест("ЗафиксироватьЗаписьОбъекта_До_Инициализации")
		.ДобавитьТестовыйНабор("РатСборДанных.ЗаписьОбъектов").ВТранзакции()
			.ДобавитьТест("ЗаписьОбъектовСправочник")
			.ДобавитьТест("ЗаписьОбъектовДокумент")
			.ДобавитьТест("ЗаписьОбъектовПланВидовХарактеристик")
			.ДобавитьТест("ЗаписьОбъектовПланСчетов")
			.ДобавитьТест("ЗаписьОбъектовПланВидовРасчета")
			.ДобавитьТест("ЗаписьОбъектовПланОбмена")
			.ДобавитьТест("ЗаписьОбъектовБизнесПроцесс")
			.ДобавитьТест("ЗаписьОбъектовЗадача")
			.ДобавитьТест("ЗаписьОбъектовРегистрСведений")
			.ДобавитьТест("ЗаписьОбъектовРегистрНакопления")
			.ДобавитьТест("ЗаписьОбъектовРегистрБухгалтерии")
			.ДобавитьТест("ЗаписьОбъектовРегистрРасчета")
			.ДобавитьТест("ЗаписьОбъектовКонстанта")
	;
		
КонецПроцедуры

Процедура ПослеКаждогоТеста() Экспорт
	
	РатСборДанных.ОстановитьСборДанных();
	
КонецПроцедуры

Процедура ИспользуетсяСборДанных_БезИнициализации() Экспорт
	
	ИспользуетсяСборДанных = РатСборДанных.ИспользуетсяСборДанных();
	ЮТест.ОжидаетЧто(ИспользуетсяСборДанных).ЭтоЛожь();
	
КонецПроцедуры

Процедура ИспользуетсяСборДанных_ПослеИнициализации() Экспорт
	
	РатСборДанных.ИнициализироватьСборДанных();
	
	ИспользуетсяСборДанных = РатСборДанных.ИспользуетсяСборДанных();
	
	ЮТест.ОжидаетЧто(ИспользуетсяСборДанных)
		.ЭтоИстина();
	
КонецПроцедуры

Процедура ЗафиксироватьЗаписьОбъекта_До_Инициализации() Экспорт
	
	ЮТест.ОжидаетЧто(РатСборДанных)
		.Метод("ЗафиксироватьЗаписьОбъекта").Параметр("")
		.ВыбрасываетИсключение("до инициализации сбора данных");
	
КонецПроцедуры

Процедура ЗаписьОбъектовСправочник() Экспорт
	
	РатСборДанных.ИнициализироватьСборДанных();
	
	Ссылка = ЮТест.Данные().СоздатьЭлемент(Справочники.ПУБ_Номенклатура);
	
	ПроверкаЗаписиОбъекта(Ссылка, "СправочникОбъект.Ф_Номенклатура");
	
КонецПроцедуры

