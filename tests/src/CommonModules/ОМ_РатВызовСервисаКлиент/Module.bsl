Процедура ВыполнитьHttpЗапрос_ЭтаБаза_ДвоичныеДанные() Экспорт
	
	Контекст = Новый Структура;
	НастройкиПодключения = РатВызовСервисаКлиент.НастройкиПодключения(Контекст, "ЭтаБаза");
	НастройкиПодключения.ИспользуетсяСериализация = Истина;
	
	УникальноеИмя = "Номенклатура" + Строка(Новый УникальныйИдентификатор);
	Base64Картинки = "base64:VGVzdA==";
	
	Данные = Новый Структура("Наименование, Картинка", УникальноеИмя, Base64Картинки);
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, "POST", "Справочник/ПУБ_Номенклатура");
	ОписаниеЗапроса.Тело = РатШагиВанессыКлиент.ДанныеОбъектаИБ(Данные);
	
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ, "Создание номенклатуры с двоичными данными")
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
		.Свойство("Тело.id").Заполнено();
	
	Идентификатор = Ответ.Тело.id;
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, "GET", "Справочник/ПУБ_Номенклатура/" + Идентификатор);
	
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ, "Получение номенклатуры с двоичными данными")
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
		.Свойство("Тело.Наименование").Равно(УникальноеИмя)
		.Свойство("Тело.Картинка")
			.ИмеетТип("Структура")
			.Свойство("Тело.Картинка.type").Равно("base64Binary")
			.Свойство("Тело.Картинка.value").Равно("VGVzdA==");
	
