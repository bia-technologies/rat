Процедура ВыполнитьHttpЗапрос_ЭтаБаза_ПолучениеДанных() Экспорт
	
	ОписаниеЗапроса = ОписаниеЗапросаЭтаБаза("Справочник/ПУБ_ОбъектыМетаданных");
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ, "Пустой справочник")
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело")
			.ИмеетТип("Массив")
			.НеЗаполнено();
	
	Ссылка = ЮТест.Данные().КонструкторОбъекта("Справочник.ПУБ_ОбъектыМетаданных")
		.ФикцияОбязательныхПолей()
		.Установить("Тип", ПредопределенноеЗначение("Перечисление.ПУБ_ТипыОбъектов.Справочник"))
		.Установить("ПометкаУдаления", Истина)
		.Записать();
	
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Справочник с одной записью")
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
		.Элемент("Тело[0]").Равно(Ссылка)
	;
	
	ОписаниеЗапроса.Тело = Новый Структура("filter", Новый Структура("ПометкаУдаления", Ложь));
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Отбор по пометке удаления (Ложь)")
		.Свойство("Тело").НеЗаполнено()
	;
	
	ОписаниеЗапроса.Тело = Новый Структура("filter", Новый Структура("ПометкаУдаления", Истина));
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Отбор по пометке удаления (Истина)")
		.Элемент("Тело[0]").Равно(Ссылка)
	;
	
	ОписаниеЗапроса.Тело = Новый Структура("filter", Новый Структура("Тип", ПредопределенноеЗначение("Перечисление.ПУБ_ТипыОбъектов.Справочник")));
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Отбор по тип (Справочник)")
		.Элемент("Тело[0]").Равно(Ссылка)
	;
	
	ОписаниеЗапроса.Тело = Новый Структура("filter", Новый Структура("Тип", ПредопределенноеЗначение("Перечисление.ПУБ_ТипыОбъектов.Документ")));
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Отбор по тип (Документ)")
		.Свойство("Тело").НеЗаполнено()
	;
	
