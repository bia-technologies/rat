Процедура УстановитьЗаголовкиНастройкиПодключения() Экспорт
	
	ИмяНастройки = "jsonplaceholder";
	Контекст = НовыйКонтекстНастройкиПодключения(ИмяНастройки);
	Заголовки = ПомощникТестированияРат.ТаблицаГеркин("| Content-Type | application/json|");
	РатВызовСервисаКлиент.УстановитьЗаголовкиНастройкиПодключения(Контекст, ИмяНастройки, Заголовки);
	
	ЮТест.ОжидаетЧто(РатВызовСервисаКлиент.НастройкиПодключения(Контекст, ИмяНастройки))
		.Свойство("Заголовки")
			.ИмеетТип("Соответствие")
			.ИмеетДлину(1)
			.ИмеетСвойство("Content-Type");
	
КонецПроцедуры

Процедура УстановитьРазрешенныеКодыОтветов() Экспорт
	
	ИмяНастройки = "jsonplaceholder";
	Контекст = НовыйКонтекстНастройкиПодключения(ИмяНастройки);
	Значение = ПомощникТестированияРат.ТаблицаГеркин(
		"| 500 |
		|| 404 |
		|| 403 |");
	РатВызовСервисаКлиент.УстановитьРазрешенныеКодыОтветов(Контекст, ИмяНастройки, Значение);
	
	ЮТест.ОжидаетЧто(РатВызовСервисаКлиент.НастройкиПодключения(Контекст, ИмяНастройки))
		.Свойство("РазрешенныеКодыСостояния")
			.ИмеетТип("Массив")
			.ИмеетДлину(3)
			.Содержит(500)
			.Содержит(404)
			.Содержит(403);
	
КонецПроцедуры

Процедура ВыполнитьHttpЗапрос_GET(ВыполнятьНаСервере) Экспорт
	
	НастройкиПодключения = НоваяНастройкаПодключения("https://jsonplaceholder.typicode.com/posts");
	НастройкиПодключения.ВыполнятьНаСервере = ВыполнятьНаСервере;
	
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, , "2");
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ)
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
			.ИмеетТип("Структура")
			.ИмеетСвойство("userId")
			.ИмеетСвойство("body")
	;
	
	НастройкиПодключения = НоваяНастройкаПодключения("https://jsonplaceholder.typicode.com");
	НастройкиПодключения.ВыполнятьНаСервере = ВыполнятьНаСервере;
	
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, , "comments");
	ОписаниеЗапроса.ПараметрыЗапроса = Новый Структура("postId", 2);
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ)
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
			.ИмеетТип("Массив")
			.КаждыйЭлементСодержитСвойствоСоЗначением("postId", 2)
	;
	
КонецПроцедуры

Процедура ВыполнитьHttpЗапрос_POST(ВыполнятьНаСервере) Экспорт
	
	НастройкиПодключения = НоваяНастройкаПодключения("https://jsonplaceholder.typicode.com");
	НастройкиПодключения.ВыполнятьНаСервере = ВыполнятьНаСервере;
	
	Тело = Новый Структура;
	Тело.Вставить("title", ЮТест.Данные().СлучайнаяСтрока());
	Тело.Вставить("body", ЮТест.Данные().СлучайнаяСтрока());
	Тело.Вставить("userId", 1);
	
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, , "posts");
	ОписаниеЗапроса.Метод = "POST";
	ОписаниеЗапроса.Тело = Тело;
	
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ)
		.Заполнено()
		.Свойство("КодСостояния").Равно(201)
		.Свойство("Тело").Заполнено()
			.ИмеетТип("Структура")
			.ИмеетСвойстваРавные(Тело)
			.ИмеетСвойство("id")
	;
	
КонецПроцедуры

Процедура ВыполнитьHttpЗапрос_POST_JSONСКлючомСДефисом() Экспорт

	НастройкиПодключения = НоваяНастройкаПодключения("https://httpbin.org");

	ВложенноеЗначение = Новый Структура("nested", 1);
	Тело = Новый Соответствие;
	Тело.Вставить("invalid-key", "Значение");
	Тело.Вставить("valid", ВложенноеЗначение);

	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, , "anything");
	ОписаниеЗапроса.Метод = "POST";
	ОписаниеЗапроса.Тело = Тело;

	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);

	ЮТест.ОжидаетЧто(Ответ)
		.Заполнено()
		.Свойство("КодСостояния").Равно(200);
	ЮТест.ОжидаетЧто(Ответ.Тело)
		.ИмеетТип("Структура")
		.Свойство("json").ИмеетТип("Соответствие");

	ДанныеJSON = Ответ.Тело.json;
	ЮТест.ОжидаетЧто(ДанныеJSON.Получить("invalid-key"))
		.Равно("Значение");
	ЮТест.ОжидаетЧто(ДанныеJSON.Получить("valid"))
		.ИмеетТип("Структура")
		.Свойство("nested").Равно(1);

КонецПроцедуры

Процедура ВыполнитьHttpЗапрос_POST_Кодировка_ContentTypeCharset() Экспорт
	
	НастройкиПодключения = НоваяНастройкаПодключения("https://httpbin.org");
	
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, , "post");
	ОписаниеЗапроса.Метод = "POST";
	ОписаниеЗапроса.Тело = Новый Структура("title", "test");
	ОписаниеЗапроса.Кодировка = "windows-1251";
	
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ)
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
	;
	
	ЮТест.ОжидаетЧто(Ответ.Тело)
		.Свойство("headers").Заполнено();
	
	ЮТест.ОжидаетЧто(Ответ.Тело)
		.Свойство("json").Заполнено();
	
	ЮТест.ОжидаетЧто(Ответ.Тело.json)
		.ИмеетТип("Структура")
		.ИмеетСвойстваРавные(ОписаниеЗапроса.Тело);
	
	ЗначениеContentType = ЗначениеЗаголовка(Ответ.Тело.headers, "Content-Type");
	
	ЮТест.ОжидаетЧто(ЗначениеContentType)
		.Заполнено()
		.Содержит("application/json")
		.Содержит("charset=")
	;
	
	ЮТест.ОжидаетЧто(НРег(ЗначениеContentType))
		.Содержит("windows-1251");
	
КонецПроцедуры

