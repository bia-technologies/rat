#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ВТранзакции()
		.ДобавитьТест("Поля_КлассифицируютсяПоСтатусам")
		.ДобавитьТест("Таблицы_КлассифицируютСтроки")
		.ДобавитьТест("БольшаяМатрица_ИспользуетFallback")
		.ДобавитьТест("ПеремещенныеСтроки_Определяются")
		.ДобавитьТест("НеверныйJSON_ВозвращаетОшибку")
		.ДобавитьТест("ФикстураDiffView_СохраняетКонтрактФормы")
	;

КонецПроцедуры

Процедура Поля_КлассифицируютсяПоСтатусам() Экспорт

	ЛеваяВерсия = Новый Структура("a, b, d", 1, 2, "same");
	ПраваяВерсия = Новый Структура("b, c, d", 3, Истина, "same");

	Результат = РатСравнениеВерсийСлужебный.ПостроитьСравнение(ЛеваяВерсия, ПраваяВерсия);

	ЮТест.ОжидаетЧто(Результат.fields)
		.ИмеетДлину(4);
	ЮТест.ОжидаетЧто(Результат.fields[0])
		.Свойство("key").Равно("a")
		.Свойство("status").Равно("removed");
	ЮТест.ОжидаетЧто(Результат.fields[1])
		.Свойство("key").Равно("b")
		.Свойство("status").Равно("changed");
	ЮТест.ОжидаетЧто(Результат.fields[2])
		.Свойство("key").Равно("c")
		.Свойство("r").Равно("true")
		.Свойство("status").Равно("added");
	ЮТест.ОжидаетЧто(Результат.fields[3])
		.Свойство("key").Равно("d")
		.Свойство("status").Равно("unchanged");

КонецПроцедуры

Процедура Таблицы_КлассифицируютСтроки() Экспорт

	Результат = РатСравнениеВерсийСлужебный.ПостроитьСравнение(ФикстураЛевойВерсии(), ФикстураПравойВерсии());
	Строки = Результат.tables[0].rows;

	ЮТест.ОжидаетЧто(Строки)
		.ИмеетДлину(4);
	ЮТест.ОжидаетЧто(Строки[0].status).Равно("unchanged");
	ЮТест.ОжидаетЧто(Строки[1].status).Равно("changed");
	ЮТест.ОжидаетЧто(Строки[2].status).Равно("added");
	ЮТест.ОжидаетЧто(Строки[3].status).Равно("removed");
	ЮТест.ОжидаетЧто(Строки[1].cellDiffs.Получить("value").leftText).Равно("1");
	ЮТест.ОжидаетЧто(Строки[1].cellDiffs.Получить("value").rightText).Равно("2");

КонецПроцедуры

Процедура БольшаяМатрица_ИспользуетFallback() Экспорт

	ЛеваяВерсия = Новый Структура("items", Таблица("Big", Новый Массив, Новый Массив));
	ПраваяВерсия = Новый Структура("items", Таблица("Big", Новый Массив, Новый Массив));
	ЛеваяВерсия.items.columns.Добавить("name");
	ПраваяВерсия.items.columns.Добавить("name");
	ЛеваяВерсия.items.rows.Добавить(СтрокаТаблицы("1", "name", "alpha"));
	ЛеваяВерсия.items.rows.Добавить(СтрокаТаблицы("2", "name", "beta"));
	ПраваяВерсия.items.rows.Добавить(СтрокаТаблицы("1", "name", "alpha"));
	ПраваяВерсия.items.rows.Добавить(СтрокаТаблицы("2", "name", "beta"));

	Результат = РатСравнениеВерсийСлужебный.ПостроитьСравнение(ЛеваяВерсия, ПраваяВерсия, Новый Структура("maxAlignCells", 1));

	ЮТест.ОжидаетЧто(Результат.tables[0].rows[0].groupId)
		.Равно("fallback-0");
	ЮТест.ОжидаетЧто(Результат.tables[0].rows[1].groupId)
		.Равно("fallback-1");

КонецПроцедуры

Процедура ПеремещенныеСтроки_Определяются() Экспорт

	Колонки = Новый Массив;
	Колонки.Добавить("name");
	ЛевыеСтроки = Новый Массив;
	ЛевыеСтроки.Добавить(СтрокаТаблицы("1", "name", "alpha"));
	ЛевыеСтроки.Добавить(СтрокаТаблицы("2", "name", "beta"));
	ЛевыеСтроки.Добавить(СтрокаТаблицы("3", "name", "gamma"));
	ПравыеСтроки = Новый Массив;
	ПравыеСтроки.Добавить(СтрокаТаблицы("2", "name", "beta"));
	ПравыеСтроки.Добавить(СтрокаТаблицы("1", "name", "alpha"));
	ПравыеСтроки.Добавить(СтрокаТаблицы("3", "name", "gamma"));

	Результат = РатСравнениеВерсийСлужебный.ПостроитьСравнение(
		Новый Структура("items", Таблица("Move", Колонки, ЛевыеСтроки)),
		Новый Структура("items", Таблица("Move", Колонки, ПравыеСтроки)));

	КоличествоПеремещенных = 0;
	Для Каждого СтрокаРазличий Из Результат.tables[0].rows Цикл
		Если СтрокаРазличий.status = "moved" Тогда
			КоличествоПеремещенных = КоличествоПеремещенных + 1;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(КоличествоПеремещенных)
		.Равно(1);

КонецПроцедуры

Процедура НеверныйJSON_ВозвращаетОшибку() Экспорт

	Результат = РатСравнениеВерсийСлужебный.ПостроитьСравнение("{", "{""ok"":true}");

	ЮТест.ОжидаетЧто(Результат.errors)
		.ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Результат.errors[0])
		.Содержит("Левая версия");
	ЮТест.ОжидаетЧто(Результат.fields)
		.ИмеетДлину(1);

КонецПроцедуры

Процедура ФикстураDiffView_СохраняетКонтрактФормы() Экспорт

	Результат = РатСравнениеВерсийСлужебный.ПостроитьСравнение(ФикстураЛевойВерсии(), ФикстураПравойВерсии());

	ЮТест.ОжидаетЧто(Результат)
		.Свойство("left").Заполнено()
		.Свойство("right").Заполнено()
		.Свойство("errors").ИмеетДлину(0)
		.Свойство("fields").ИмеетДлину(3)
		.Свойство("tables").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Результат.fields[1])
		.Свойство("key").Равно("b")
		.Свойство("l").Равно("2")
		.Свойство("r").Равно("3")
		.Свойство("status").Равно("changed");
	ЮТест.ОжидаетЧто(Результат.tables[0])
		.Свойство("path").Равно("items")
		.Свойство("title").Равно("Items");
	ЮТест.ОжидаетЧто(Результат.tables[0].rows[2])
		.Свойство("status").Равно("added")
		.Свойство("groupId").Равно("pair-2-2")
		.Свойство("pair").Заполнено()
		.Свойство("cellDiffs").Заполнено();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ФикстураЛевойВерсии()

	Колонки = Новый Массив;
	Колонки.Добавить("name");
	Колонки.Добавить("value");
	Строки = Новый Массив;
	Строки.Добавить(СтрокаТаблицы("1", "name", "alpha", "value", 1));
	Строки.Добавить(СтрокаТаблицы("2", "name", "beta", "value", 1));
	Строки.Добавить(СтрокаТаблицы("3", "name", "left-only", "value", "x"));

	Возврат Новый Структура("a, b, items", 1, 2, Таблица("Items", Колонки, Строки));

КонецФункции

Функция ФикстураПравойВерсии()

	Колонки = Новый Массив;
	Колонки.Добавить("name");
	Колонки.Добавить("value");
	Строки = Новый Массив;
	Строки.Добавить(СтрокаТаблицы("1", "name", "alpha", "value", 1));
	Строки.Добавить(СтрокаТаблицы("2", "name", "beta", "value", 2));
	Строки.Добавить(СтрокаТаблицы("4", "name", "right-only", "value", "y"));

	Возврат Новый Структура("a, b, c, items", 1, 3, 4, Таблица("Items", Колонки, Строки));

КонецФункции

Функция Таблица(Имя, Колонки, Строки)

	Возврат Новый Структура("type, name, columns, rows", "table", Имя, Колонки, Строки);

КонецФункции

Функция СтрокаТаблицы(Идентификатор, ИмяПоля1, ЗначениеПоля1, ИмяПоля2 = Неопределено, ЗначениеПоля2 = Неопределено)

	Ячейки = Новый Соответствие;
	Ячейки.Вставить(ИмяПоля1, ЗначениеПоля1);
	Если ИмяПоля2 <> Неопределено Тогда
		Ячейки.Вставить(ИмяПоля2, ЗначениеПоля2);
	КонецЕсли;

	Возврат Новый Структура("id, cells", Идентификатор, Ячейки);

КонецФункции

#КонецОбласти
