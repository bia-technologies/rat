#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ВТранзакции()
		// СериализоватьСсылку
		.ДобавитьТест("СериализоватьСсылку_Справочник")
		.ДобавитьТест("СериализоватьСсылку_Документ")
		.ДобавитьТест("СериализоватьСсылку_Перечисление")
		.ДобавитьТест("СериализоватьСсылку_ПустаяСсылка")
		// СериализоватьРеквизитСоставногоТипа
		.ДобавитьТест("СериализоватьРеквизитСоставногоТипа_Справочник")
		.ДобавитьТест("СериализоватьРеквизитСоставногоТипа_Число")
		.ДобавитьТест("СериализоватьРеквизитСоставногоТипа_Неопределено")
		// ДесериализоватьСсылку
		.ДобавитьТест("ДесериализоватьСсылку_ПоУИД")
		.ДобавитьТест("ДесериализоватьСсылку_ПоПредопределенному")
		.ДобавитьТест("ДесериализоватьСсылку_ПоРеквизиту")
		.ДобавитьТест("ДесериализоватьСсылку_ПустаяСтрока")
		// ДесериализоватьПеречисление
		.ДобавитьТест("ДесериализоватьПеречисление_ПоИмени")
		.ДобавитьТест("ДесериализоватьПеречисление_ПоXML")
		.ДобавитьТест("ДесериализоватьПеречисление_НекорректноеЗначение")
		// НайтиСсылкуПоИдентификатору
		.ДобавитьТест("НайтиСсылкуПоИдентификатору_ПоУИД_Справочник")
		.ДобавитьТест("НайтиСсылкуПоИдентификатору_ПоПредопределенному")
		.ДобавитьТест("НайтиСсылкуПоИдентификатору_ПоРеквизиту")
		// ИмяЭлементаПеречисления
		.ДобавитьТест("ИмяЭлементаПеречисления_Успешно")
		// ДесериализоватьРеквизитСоставногоТипа
		.ДобавитьТест("ДесериализоватьРеквизитСоставногоТипа_Справочник")
		.ДобавитьТест("ДесериализоватьРеквизитСоставногоТипа_НесоответствиеТипа");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СериализоватьСсылку

Процедура СериализоватьСсылку_Справочник() Экспорт
	
	// Arrange
	Справочник = ЮТест.Данные().КонструкторОбъекта("Справочник.Ф_Номенклатура")
		.ФикцияОбязательныхПолей()
		.Записать();
	
	// Act
	Результат = РатПреобразованияСсылки.СериализоватьСсылку(Справочник.Ссылка, ТипЗнч(Справочник.Ссылка));
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации справочника")
		.ИмеетТип("Структура")
		.Свойство("type").Равно("CatalogRef.Ф_Номенклатура")
		.Свойство("id").Равно(Строка(Справочник.УникальныйИдентификатор()))
		.Свойство("presentation").Равно(Справочник.Наименование);
	
КонецПроцедуры

