#Область СлужебныйПрограммныйИнтерфейс

// Регистрация тестовых методов
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции()
		// ЗначенияИдентификатора
		.ДобавитьТест("ЗначенияИдентификатора_ПростойКлюч")
		.ДобавитьТест("ЗначенияИдентификатора_СоставнойКлюч")
		.ДобавитьТест("ЗначенияИдентификатора_ПустойИдентификатор")
		.ДобавитьТест("ЗначенияИдентификатора_СПробелами")
		
		// СериализоватьКлючЗаписи
		.ДобавитьТест("СериализоватьКлючЗаписи_РегистрСведений")
		.ДобавитьТест("СериализоватьКлючЗаписи_РегистрНакопления")
		.ДобавитьТест("СериализоватьКлючЗаписи_СоставнойКлюч")
		
		// ДесериализоватьКлючЗаписи
		.ДобавитьТест("ДесериализоватьКлючЗаписи_РегистрСведений")
		.ДобавитьТест("ДесериализоватьКлючЗаписи_РегистрНакопления")
		.ДобавитьТест("ДесериализоватьКлючЗаписи_НекорректныйИдентификатор")
		.ДобавитьТест("ДесериализоватьКлючЗаписи_ОтсутствуетОбязательноеПоле");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗначенияИдентификатора

Процедура ЗначенияИдентификатора_ПростойКлюч() Экспорт
	
	// Arrange
	Идентификатор = "Поле1=Значение1";
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.ЗначенияИдентификатора(Идентификатор);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат разбора простого ключа")
		.ИмеетТип("Структура")
		.ИмеетСвойство("Поле1")
		.Свойство("Поле1").Равно("Значение1");
	
КонецПроцедуры

Процедура ЗначенияИдентификатора_СоставнойКлюч() Экспорт
	
	// Arrange
	Идентификатор = "Поле1=Значение1;Поле2=Значение2;Поле3=Значение3";
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.ЗначенияИдентификатора(Идентификатор);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат разбора составного ключа")
		.ИмеетТип("Структура")
		.ИмеетДлину(3)
		.Свойство("Поле1").Равно("Значение1")
		.Свойство("Поле2").Равно("Значение2")
		.Свойство("Поле3").Равно("Значение3");
	
КонецПроцедуры

Процедура ЗначенияИдентификатора_ПустойИдентификатор() Экспорт
	
	// Arrange
	Идентификатор = "";
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.ЗначенияИдентификатора(Идентификатор);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат разбора пустого идентификатора")
		.ИмеетТип("Структура")
		.ИмеетДлину(0);
	
КонецПроцедуры

Процедура ЗначенияИдентификатора_СПробелами() Экспорт
	
	// Arrange
	Идентификатор = " Поле1 = Значение1 ; Поле2 = Значение2 ";
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.ЗначенияИдентификатора(Идентификатор);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат разбора ключа с пробелами")
		.ИмеетТип("Структура")
		.ИмеетДлину(2)
		.Свойство("Поле1").Равно("Значение1")
		.Свойство("Поле2").Равно("Значение2");
	
КонецПроцедуры

#КонецОбласти

#Область СериализоватьКлючЗаписи

Процедура СериализоватьКлючЗаписи_РегистрСведений() Экспорт
	
	// Arrange
	ПараметрыКлюча = Новый Структура;
	ПараметрыКлюча.Вставить("Число", 42);
	ПараметрыКлюча.Вставить("Строка", "Тест");
	ПараметрыКлюча.Вставить("Дата", ТекущаяДатаСеанса());
	
	КлючЗаписи = РегистрыСведений.Ф_ПримитивныеИзмерения.СоздатьКлючЗаписи(ПараметрыКлюча);
	ТипКлюча = ТипЗнч(КлючЗаписи);
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.СериализоватьКлючЗаписи(КлючЗаписи, ТипКлюча);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации ключа регистра сведений")
		.ИмеетТип("Структура")
		.ИмеетСвойство("Число")
		.ИмеетСвойство("Строка")
		.ИмеетСвойство("Дата")
		.Свойство("Число").Равно(42)
		.Свойство("Строка").Равно("Тест");
	
КонецПроцедуры

Процедура СериализоватьКлючЗаписи_РегистрНакопления() Экспорт
	
	// Arrange - создаем тестовые элементы справочников
	Склад = ЮТест.Данные().СоздатьЭлемент(Справочники.ПУБ_Склады);
	Номенклатура = ЮТест.Данные().СоздатьЭлемент(Справочники.ПУБ_Номенклатура);
	
	ПараметрыКлюча = Новый Структура;
	ПараметрыКлюча.Вставить("Склад", Склад);
	ПараметрыКлюча.Вставить("Номенклатура", Номенклатура);
	
	КлючЗаписи = РегистрыНакопления.ПУБ_ОстаткиТоваров.СоздатьКлючЗаписи(ПараметрыКлюча);
	ТипКлюча = ТипЗнч(КлючЗаписи);
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.СериализоватьКлючЗаписи(КлючЗаписи, ТипКлюча);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации ключа регистра накопления")
		.ИмеетТип("Структура")
		.ИмеетДлинуБольше(0);
	
КонецПроцедуры

Процедура СериализоватьКлючЗаписи_СоставнойКлюч() Экспорт
	
	// Arrange
	ПараметрыКлюча = Новый Структура;
	ПараметрыКлюча.Вставить("Число", 100);
	ПараметрыКлюча.Вставить("Строка", "Составной");
	ПараметрыКлюча.Вставить("Дата", '20240101');
	
	КлючЗаписи = РегистрыСведений.Ф_ПримитивныеИзмерения.СоздатьКлючЗаписи(ПараметрыКлюча);
	ТипКлюча = ТипЗнч(КлючЗаписи);
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.СериализоватьКлючЗаписи(КлючЗаписи, ТипКлюча);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации составного ключа")
		.ИмеетТип("Структура")
		.ИмеетДлину(3)
		.Свойство("Число").Равно(100)
		.Свойство("Строка").Равно("Составной");
	
КонецПроцедуры

#КонецОбласти

#Область ДесериализоватьКлючЗаписи

Процедура ДесериализоватьКлючЗаписи_РегистрСведений() Экспорт
	
	// Arrange
	Идентификатор = "Число=42;Строка=Тест;Дата=2024-01-01T00:00:00";
	ИмяТаблицы = "РегистрСведений.Ф_ПримитивныеИзмерения";
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.ДесериализоватьКлючЗаписи(Идентификатор, ИмяТаблицы, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат десериализации ключа регистра сведений")
		.ИмеетТип("РегистрСведенийКлючЗаписи.Ф_ПримитивныеИзмерения")
		.Свойство("Число").Равно(42)
		.Свойство("Строка").Равно("Тест");
		
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус обработки запроса")
		.ЭтоИстина();
	
КонецПроцедуры

Процедура ДесериализоватьКлючЗаписи_РегистрНакопления() Экспорт
	
	// Arrange - создаем тестовые элементы справочников
	Склад = ЮТест.Данные().СоздатьЭлемент(Справочники.ПУБ_Склады);
	Номенклатура = ЮТест.Данные().СоздатьЭлемент(Справочники.ПУБ_Номенклатура);
	
	Идентификатор = СтрШаблон("Склад=%1;Номенклатура=%2",
		Склад.УникальныйИдентификатор(),
		Номенклатура.УникальныйИдентификатор());
	ИмяТаблицы = "РегистрНакопления.ПУБ_ОстаткиТоваров";
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.ДесериализоватьКлючЗаписи(Идентификатор, ИмяТаблицы, СтатусОбработкиЗапроса);
	
	// Assert - проверяем, что функция работает корректно
	// Если десериализация не удалась, проверяем статус ошибки
	Если Результат = Неопределено Тогда
		ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус обработки при ошибке десериализации")
			.ЭтоЛожь();
	Иначе
		ЮТест.ОжидаетЧто(Результат, "Результат десериализации ключа регистра накопления")
			.ИмеетТип("РегистрНакопленияКлючЗаписи.ПУБ_ОстаткиТоваров");
			
		ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус обработки при успешной десериализации")
			.ЭтоИстина();
	КонецЕсли;
	
КонецПроцедуры

Процедура ДесериализоватьКлючЗаписи_НекорректныйИдентификатор() Экспорт
	
	// Arrange
	Идентификатор = "Некорректный=Формат;БезРавенства;";
	ИмяТаблицы = "РегистрСведений.Ф_ПримитивныеИзмерения";
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.ДесериализоватьКлючЗаписи(Идентификатор, ИмяТаблицы, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат десериализации некорректного идентификатора")
		.ЭтоНеопределено();
		
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус обработки при некорректном идентификаторе")
		.ЭтоЛожь();
	
КонецПроцедуры

Процедура ДесериализоватьКлючЗаписи_ОтсутствуетОбязательноеПоле() Экспорт
	
	// Arrange
	Идентификатор = "Число=42"; // Отсутствует обязательное поле Строка
	ИмяТаблицы = "РегистрСведений.Ф_ПримитивныеИзмерения";
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияКлючиЗаписи.ДесериализоватьКлючЗаписи(Идентификатор, ИмяТаблицы, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат десериализации при отсутствии обязательного поля")
		.ЭтоНеопределено();
		
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус обработки при отсутствии обязательного поля")
		.ЭтоЛожь();
	
КонецПроцедуры

#КонецОбласти

