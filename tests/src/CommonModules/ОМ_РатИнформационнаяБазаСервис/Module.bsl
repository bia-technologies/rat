КонецПроцедуры

Процедура ПолучитьЭлемент_Регистр() Экспорт
	
	Объект = ЮТест.Данные().СоздатьЭлемент(Документы.Ф_Чек);
	Комментарий = Строка(Объект.УникальныйИдентификатор());
	
	ЗаписьРС = РегистрыСведений.Ф_КомментарииПоОбъекту.СоздатьМенеджерЗаписи();
	
	ЗаписьРС.Объект = Объект;
	ЗаписьРС.Период = ТекущаяДатаСеанса();
	ЗаписьРС.Комментарий = Комментарий;
	ЗаписьРС.Записать();
	
	ИдентификаторЗаписи = СтрШаблон("Объект=Документы.Ф_Чек.%1;Период=%2",
									ЗаписьРС.Объект.УникальныйИдентификатор(),
									ПомощникТестированияРат.ДатаISO8601(ЗаписьРС.Период));
	
	ИдентификаторЗаписи2 = СтрШаблон("Объект=Документ.Ф_Чек.%1;Период=%2",
									 ЗаписьРС.Объект.Номер,
									 ПомощникТестированияРат.ДатаISO8601(ЗаписьРС.Период));
	
	Варианты = ЮТест.Варианты("Адрес")
		.Добавить("РегистрСведений/Ф_КомментарииПоОбъекту/"+ ИдентификаторЗаписи)
		.Добавить("РегистрыСведений/Ф_КомментарииПоОбъекту/" + ИдентификаторЗаписи)
		.Добавить("РегистрыСведений/Ф_КомментарииПоОбъекту/" + ИдентификаторЗаписи2)
	;
	
	Для Каждого Вариант Из Варианты.СписокВариантов() Цикл
		СтатусОбработкиЗапроса = ВызовОбработчикаПолучитьЗаписьТаблицы(Вариант.Адрес);
		Описание = ТестированиеСервер.Представление(Вариант, , "Вариант");
		ПроверитьРезультат(СтатусОбработкиЗапроса, Описание, Неопределено);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьЭлемент_Ошибки() Экспорт
	
	Классы = РатПовтИсп.КлассыОшибок();
	Варианты = ЮТест.Варианты("Адрес, КлассОшибки")
		.Добавить("Документ/Ф_Чек/1", Классы.НеНайденаЗаписьИБ)
		.Добавить("РегистрыСведений/Ф_КомментарииПоОбъекту/Объект=123;Период=2025-04-14T11:37:08", Классы.АнализПараметровЗапроса)
	;
	
	Для Каждого Вариант Из Варианты.СписокВариантов() Цикл
		СтатусОбработкиЗапроса = ВызовОбработчикаПолучитьЗаписьТаблицы(Вариант.Адрес);
		Описание = ТестированиеСервер.Представление(Вариант, , "Вариант");
		ПроверитьРезультат(СтатусОбработкиЗапроса, Описание, Вариант.КлассОшибки);
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьДанные_Справочник() Экспорт
	
	Описание = "Справочник без табличной части";
	
	СтатусОбработкиЗапроса = ВызовОбработчикаСоздатьЗаписьТаблицы("Справочник/Ф_Номенклатура", 
		ТелоДанныеОбъекта(Новый Структура("Наименование", "Рупия")));
	ПомощникТестированияРат.ПроверитьРезультатУспешно(СтатусОбработкиЗапроса, Описание);
	
	Описание = "Справочник с табличной частью";
	
	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("ИмяРеквизита, ПредставлениеТипа", "1", "1.1"));
	Строки.Добавить(Новый Структура("ИмяРеквизита, ПредставлениеТипа", "2", "2.1"));
	СтатусОбработкиЗапроса = ВызовОбработчикаСоздатьЗаписьТаблицы("Справочник/Ф_ОбъектыМетаданных", 
		ТелоДанныеОбъекта(Новый Структура("Наименование, Реквизиты", "Рупия", Строки)));
	ПомощникТестированияРат.ПроверитьРезультатУспешно(СтатусОбработкиЗапроса, Описание);
	
	Описание = "Без тела";
	
	СтатусОбработкиЗапроса = ВызовОбработчикаСоздатьЗаписьТаблицы("Справочник/Ф_Номенклатура", 
		ТелоДанныеОбъекта(Новый Структура));
	ПомощникТестированияРат.ПроверитьРезультатУспешно(СтатусОбработкиЗапроса, Описание);
	
КонецПроцедуры

Процедура СоздатьДанные_Документ() Экспорт
	
	Описание = "Документ с табличной частью";
	Товар = ЮТест.Данные().СоздатьЭлемент(Справочники.Ф_Номенклатура);
	ИдентификаторТовара = Строка(Товар.УникальныйИдентификатор());
	
	Данные = Новый Структура;
	Данные.Вставить("НомерСмены", 1);
	Данные.Вставить("ВидОперации", Перечисления.Ф_ВидыОпераций.Приход);
	Данные.Вставить("ТоварыУслуги", Новый Массив);
	Данные.ТоварыУслуги.Добавить(Новый Структура("Номенклатура, Количество, Цена, Сумма", ИдентификаторТовара, 1, 1, 1));
	
	СтатусОбработкиЗапроса = ВызовОбработчикаСоздатьЗаписьТаблицы("Документ/Ф_Чек", 
		ТелоДанныеОбъекта(Данные));
	ПомощникТестированияРат.ПроверитьРезультатУспешно(СтатусОбработкиЗапроса, Описание);
	
КонецПроцедуры

