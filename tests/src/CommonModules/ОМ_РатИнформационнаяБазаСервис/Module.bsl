		Адрес = СтрЗаменить(Вариант, ".", "/") + "/" + Ссылка.УникальныйИдентификатор();
		Статус = ВызовОбработчикаУдалитьДанные(Адрес);
		
		ПомощникТестированияРат.ПроверитьРезультатУспешно(Статус, "Удаление " + Вариант);
		ЮТест.ОжидаетЧто(Ссылка, "Проверка удаленного объекта " + Вариант)
			.Свойство("ПометкаУдаления").ЭтоИстина();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьДанные_Регистр() Экспорт
	
	Объект = ЮТест.Данные().СоздатьЭлемент(Справочники.Ф_Номенклатура);
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта(РегистрыСведений.Ф_КомментарииПоОбъекту)
		.Установить("Объект", Объект)
		.ФикцияОбязательныхПолей();
	
	КлючЗаписи = Конструктор.Записать();
	
	Период2 = ТекущаяДатаСеанса() + 999999;
	Конструктор.Установить("Период", Период2)
		.Записать();
	
	ПредикатКлюч = ЮТест.Предикат()
		.Реквизит("Объект").Равно(КлючЗаписи.Объект)
		.Реквизит("Период").Равно(КлючЗаписи.Период)
		.Получить();
	ПредикатОбъект = ЮТест.Предикат()
		.Реквизит("Объект").Равно(КлючЗаписи.Объект)
		.Получить();
	ЮТест. ОжидаетЧтоТаблицаБазы("РегистрСведений.Ф_КомментарииПоОбъекту")
		.СодержитЗаписи(ПредикатКлюч, "Первоначальная запись");
	
	// -----------------------------
	Описание = "Удаление записи регистра по неподходящему отбору";
	Адрес = СтрШаблон("РегистрыСведений/Ф_КомментарииПоОбъекту/Объект=Справочник.Ф_Номенклатура.%1;Период=2030-01-01",
					  Объект.УникальныйИдентификатор());
	Статус = ВызовОбработчикаУдалитьДанные(Адрес);
	ПомощникТестированияРат.ПроверитьРезультатУспешно(Статус, Описание);
	ЮТест. ОжидаетЧтоТаблицаБазы("РегистрСведений.Ф_КомментарииПоОбъекту")
		.СодержитЗаписи(ПредикатКлюч, Описание);
	
	// -----------------------------
	Описание = "Удаление записи регистра по полному ключу";
	Адрес = СтрШаблон("РегистрыСведений/Ф_КомментарииПоОбъекту/Объект=Справочник.Ф_Номенклатура.%1;Период=%2",
					  Объект.УникальныйИдентификатор(), ПомощникТестированияРат.ДатаISO8601(КлючЗаписи.Период));
	Статус = ВызовОбработчикаУдалитьДанные(Адрес);
	ПомощникТестированияРат.ПроверитьРезультатУспешно(Статус, Описание);
	ЮТест. ОжидаетЧтоТаблицаБазы("РегистрСведений.Ф_КомментарииПоОбъекту")
		.НеСодержитЗаписи(ПредикатКлюч, Описание)
		.СодержитЗаписи(ПредикатОбъект, Описание);
	
	// -----------------------------
	Описание = "Удаление записи регистра по неполному ключу";
	Адрес = СтрШаблон("РегистрыСведений/Ф_КомментарииПоОбъекту/Объект=Справочник.Ф_Номенклатура.%1",
					  Объект.УникальныйИдентификатор());
	Статус = ВызовОбработчикаУдалитьДанные(Адрес);
	ПомощникТестированияРат.ПроверитьРезультатОшибка(Статус, Описание, РатОбщий.КлассыОшибок().Десериализация);
	
КонецПроцедуры

