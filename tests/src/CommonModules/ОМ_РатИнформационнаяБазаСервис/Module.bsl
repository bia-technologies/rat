	//---------------------------------
	Описание = "Ошибка приведения типов";
	
	Данные = Новый Структура("Объект, Пеирод",
							 "Документы.Ф_Чек." + ИдентификаторСсылки,
							 "123");
	
	СтатусОбработкиЗапроса = ВызовОбработчикаСоздатьЗаписьТаблицы("РегистрСведений/Ф_КомментарииПоОбъекту", 
		ТелоДанныеОбъекта(Данные));
	ПомощникТестированияРат.ПроверитьРезультатОшибка(СтатусОбработкиЗапроса, Описание, Классы.АнализПараметровЗапроса);
	
	//---------------------------------
	Описание = "Некорректное тело";
	
	СтатусОбработкиЗапроса = ВызовОбработчикаСоздатьЗаписьТаблицы("РегистрСведений/Ф_КомментарииПоОбъекту", 
		ТелоДанныеОбъекта(1));
	ПомощникТестированияРат.ПроверитьРезультатОшибка(СтатусОбработкиЗапроса, Описание, Классы.АнализПараметровЗапроса);
	
	//---------------------------------
	Описание = "Не указан тип составного реквиззита";
	
	Данные = Новый Структура("Объект, Пеирод",
							 ИдентификаторСсылки,
							 "123");
	
	СтатусОбработкиЗапроса = ВызовОбработчикаСоздатьЗаписьТаблицы("РегистрСведений/Ф_КомментарииПоОбъекту", 
		ТелоДанныеОбъекта(Данные));
	ПомощникТестированияРат.ПроверитьРезультатОшибка(СтатусОбработкиЗапроса, Описание, Классы.АнализПараметровЗапроса);
	
КонецПроцедуры

Процедура СоздатьДанныеСУказаниемСсылки() Экспорт
	
	Описание = "Запись с указанием ссылки нового";
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Запись = Новый Структура("Ссылка, Наименование", Идентификатор, "Рупия2");
	
	СтатусОбработкиЗапроса = ВызовОбработчикаСоздатьЗаписьТаблицы("Справочник/Ф_Номенклатура", Новый Структура("data", Запись));
	ПроверитьРезультат(СтатусОбработкиЗапроса, Описание, Неопределено);
	
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Результат, Описание)
		.ИмеетТип("СправочникСсылка.Ф_Номенклатура");
	ЮТест.ОжидаетЧто(Строка(СтатусОбработкиЗапроса.Результат.УникальныйИдентификатор()), Описание)
		.Равно(Идентификатор);
	
КонецПроцедуры

Процедура ИзменитьДанные() Экспорт
	
	Ссылка = ЮТест.Данные().СоздатьЭлемент(Справочники.Ф_Номенклатура);
	
	ТаблицаВариантов = СтрШаблон("| Тип        | Вид              | КодОбъекта | КодОшибки               |
								 ||------------|------------------|------------|-------------------------|
								 || Справочник | Ф_Склады       | йцук       | НеНайденаЗаписьИБ       |
								 || Справочник | Ф_Номенклатура | %1         |                         |
								 || Справочник | Ф_Номенклатура | %1         | НеНайденаЗаписьИБ       |
								 |", Ссылка.Код);
	Варианты = ЮТТестовыеДанные.ТаблицаMarkDown(ТаблицаВариантов);
	
	Классы = РатОбщий.КлассыОшибок();
	
	Для Каждого Вариант Из Варианты Цикл
		
		Адрес = СтрШаблон("%1/%2/%3", Вариант.Тип, Вариант.Вид, Вариант.КодОбъекта);
		Тело = Новый Структура("Код, Наименование", "Тестовый код", "Тестовое наименование");
		
		Статус = ВызовОбработчикаИзменитьЗаписьТаблицы(Адрес, Новый Структура("data", Тело));
		
		Описание = ТестированиеСервер.Представление(Вариант, , "Вариант");
		
		Если Не ПустаяСтрока(Вариант.КодОшибки) Тогда
			КлассОшибки = Классы[Вариант.КодОшибки];
		Иначе
			КлассОшибки = Неопределено;
		КонецЕсли;
		
		ПроверитьРезультат(Статус, Описание, КлассОшибки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьДанные() Экспорт

	Варианты = Новый Массив;
	Варианты.Добавить("Справочник.Ф_Номенклатура");
	Варианты.Добавить("ПланВидовХарактеристик.Ф_ПВХ");
