Процедура РасширеннаяФильтрация() Экспорт
	
	Данные = Новый Массив;
	
	Идентификатор = ЮТест.Данные().СлучайнаяСтрока();
	ИмяРеквизита = ЮТест.Данные().СлучайнаяСтрока();
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.Ф_ОбъектыМетаданных)
		.Фикция("Наименование")
		.ТабличнаяЧасть("Реквизиты")
			.ДобавитьСтроку()
				.Установить("ИмяРеквизита", ИмяРеквизита);
	Данные.Добавить(Конструктор.Записать());
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.Ф_ОбъектыМетаданных)
		.Установить("Наименование", Идентификатор)
		.ТабличнаяЧасть("Реквизиты")
			.ДобавитьСтроку()
				.Фикция("ИмяРеквизита");
	
	Данные.Добавить(Конструктор.Записать());
	
	Конструктор.Установить("ИмяРеквизита", ИмяРеквизита);
	Данные.Добавить(Конструктор.Записать());
	
	Адрес = "Справочник/Ф_ОбъектыМетаданных";
	
	Варианты = ЮТест.Варианты("Реквизит, Условие, Значение, РазмерРезультата")
		.Добавить("Наименование", Неопределено, Идентификатор, 2)
		.Добавить("Реквизиты.ИмяРеквизита", Неопределено, ИмяРеквизита, 2)
		.Добавить("Наименование", "НачинаетсяС", "123", 0)
		.Добавить("Наименование", "ЗаканчиваетсяНа", "123", 0)
		.Добавить("Ссылка", "ВГруппе", Данные[0], 1)
		.Добавить("Наименование", "ВСписке", ЮТКоллекции.ЗначениеВМассиве(Идентификатор), 2)
	;
	
	Для Каждого Вариант Из Варианты.СписокВариантов() Цикл
		Тело = Фильтр(Вариант.Реквизит, Вариант.Значение, , Вариант.Условие);
		Описание = СтрШаблон("%1 %2 %3", Вариант.Реквизит, Вариант.Условие, Вариант.Значение);
		
		ПроверитьФильтрацию(Адрес, Тело, Описание, Вариант.РазмерРезультата);
	КонецЦикла;
	
	Тело = Фильтр("Реквизиты.ИмяРеквизита", ИмяРеквизита, , "НеРавно");
	Фильтр("Наименование", Идентификатор, , "Равно", Тело);
	ПроверитьФильтрацию(Адрес, Тело, "Получение списка составное условие", 1);
	
	Тело = Фильтр("Реквизиты.ИмяРеквизита", ИмяРеквизита, , "НеРавно");
	Фильтр("Наименование", ЮТКоллекции.ЗначениеВМассиве(Идентификатор), , "ВСписке", Тело);
	ПроверитьФильтрацию(Адрес, Тело, "Получение списка составное условие", 1);
	
	Фильтр("Наименование", Идентификатор, , "ВСписке", Тело);
	ПроверитьФильтрацию(Адрес, Тело, "Получение списка составное условие", 1);
	
	Фильтр("Наименование",
		   ЮТКоллекции.ЗначениеВМассиве(Новый Структура("value, type", Идентификатор, "string")),
		   ,
		   "ВСписке",
		   Тело);
	ПроверитьФильтрацию(Адрес, Тело, "Получение списка составное условие", 1);
	
КонецПроцедуры

Процедура ИзмененитьЗначениеИзмеренияРегистра() Экспорт
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта(РегистрыСведений.Ф_ПримитивныеИзмерения)
		.ФикцияРеквизитов("Число, Строка, Дата, Булево, УникальныйИдентификатор");
	
	Данные = Конструктор.ДанныеОбъекта();
	Ключ = Конструктор.Записать();
	
	Адрес = СтрШаблон("РегистрСведений/Ф_ПримитивныеИзмерения/Число=%1;Строка=%2;Дата=%3", 
		Формат(Ключ.Число, "ЧГ=0;"),
		Ключ.Строка,
		Формат(Ключ.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss;"));
	
	НовыеДанные = ЮТКоллекции.СкопироватьСтруктуру(Данные);
	НовыеДанные.Число = НовыеДанные.Число + 1;
	
	Статус = ВызовОбработчикаИзменитьЗаписьТаблицы(Адрес, Новый Структура("data", Новый Структура("Число", НовыеДанные.Число)));
	ПомощникТестированияРат.ПроверитьРезультатУспешно(Статус);
	
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.Ф_ПримитивныеИзмерения")
		.НеСодержитЗаписи(ЮТест.Предикат(Данные));
	
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.Ф_ПримитивныеИзмерения")
		.СодержитЗаписи(ЮТест.Предикат(НовыеДанные));
	
