Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции()
		.ДобавитьТест("ПолучитьДанныеСписка")
			.СПараметрами("Справочник/Ф_Номенклатура", Новый Структура("ПометкаУдаления", Ложь))
			.СПараметрами("Справочники/Ф_Номенклатура", , "Наименование")
			.СПараметрами("Документ/Ф_Чек", , , "НомерСмены, ТоварыУслуги")
			.СПараметрами("РегистрыСведений/Ф_КомментарииПоОбъекту")
			.СПараметрами("Перечисления/Ф_ВидыОпераций")
		.ДобавитьТест("ПолучитьДанныеСписка_ОшибкаПараметров")
			.СПараметрами("РазборПараметровЗапроса", 1)
			.СПараметрами("РазборПараметровЗапроса", "1")
			.СПараметрами("РазборПараметровЗапроса", Новый Структура("Номер", 1))
			.СПараметрами("АнализПараметровЗапроса", Новый Структура("Тип", "Справочник"), "Номер")
			.СПараметрами("НеНайденаЗаписьИБ", Новый Структура("Тип", "НетТакого"))
			
		.ДобавитьТест("ПолучитьДанныеСписка_Лимит")
		.ДобавитьТест("ПолучитьЭлемент_Справочник")
		.ДобавитьТест("ПолучитьЭлемент_Документ")
		.ДобавитьТест("ПолучитьЭлемент_Регистр")
		.ДобавитьТест("ПолучитьЭлемент_Ошибки")
		.ДобавитьТест("СоздатьДанные_Справочник")
		.ДобавитьТест("СоздатьДанные_Документ")
		.ДобавитьТест("СоздатьДанные_Регистр")
		.ДобавитьТест("СоздатьДанные_Ошибки")
		.ДобавитьТест("СоздатьДанныеСУказаниемСсылки")
		.ДобавитьТест("ИзменитьДанные")
		.ДобавитьТест("УдалитьДанные")
		.ДобавитьТест("УдалитьДанные_Регистр")
		
		.ДобавитьТест("РасширеннаяФильтрация")
		.ДобавитьТест("МетаданныеТаблицы")
		.ДобавитьТест("ИспользованиеВыражения")
		
		.ДобавитьТестовыйНабор("ИсправлениеОшибок")
			.ДобавитьТест("УдалитьДанныеПоПустомуСоставномуРеквизиту")
			.ДобавитьТест("ОшибкаРазбораНаименования")
			.ДобавитьТест("ИзмененитьЗначениеИзмеренияРегистра")
	;
	КонецПроцедуры

Процедура ПолучитьДанныеСписка(Адрес, Отбор = "!%№", Порядок = "!%№", Поля = "!%№") Экспорт

	Тело = ТелоЗапросаСписка(Отбор, Порядок, Поля);
	СтатусОбработкиЗапроса = ВызовОбработчикаПолученияДанныхСписка(Адрес, Тело);

	ПроверитьРезультат(СтатусОбработкиЗапроса, Неопределено, Неопределено);

КонецПроцедуры

Процедура ПолучитьДанныеСписка_ОшибкаПараметров(Ошибка, Отбор = "!%№", Порядок = "!%№", Поля = "!%№") Экспорт

	ОжидаемаяОшибка = РатПовтИсп.КлассыОшибок()[Ошибка];

	Тело = ТелоЗапросаСписка(Отбор, Порядок, Поля);
	СтатусОбработкиЗапроса = ВызовОбработчикаПолученияДанныхСписка("Справочник/Ф_ОбъектыМетаданных", Тело);

	ПроверитьРезультат(СтатусОбработкиЗапроса, Неопределено, ОжидаемаяОшибка);

КонецПроцедуры

Процедура ПолучитьДанныеСписка_Лимит() Экспорт
	
	// Подготовка данных
	Объект = ЮТест.Данные().СоздатьЭлемент("Справочник.Ф_Номенклатура");
	Конструктор = ЮТест.Данные().КонструкторОбъекта("РегистрСведений.Ф_КомментарииПоОбъекту").Установить("Объект", Объект);
	Период = ЮТест.Данные().СлучайнаяДата();
	КоличествоЭлементов = 101;
	
	Для Инд = 1 По КоличествоЭлементов Цикл
		
		Конструктор.Фикция("Комментарий").Установить("Период", Период + Инд).Записать();
		;
		
	КонецЦикла;
	
	ТелоЗапроса = Новый Структура("limit", КоличествоЭлементов);
	// Действие
	СтатусОбработкиЗапроса = ВызовОбработчикаПолученияДанныхСписка("РегистрСведений/Ф_КомментарииПоОбъекту", ТелоЗапроса);
	
	// Проверки
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Результат)
		.ИмеетТип("ТаблицаЗначений")
		.ИмеетДлину(КоличествоЭлементов);
	
КонецПроцедуры

Процедура ОшибкаРазбораНаименования() Экспорт
	
	Наименование = "А. и (Б), с-и-д-е-л-и.";
	ЮТест.Данные().СоздатьЭлемент(Справочники.Ф_Номенклатура, Наименование);
	Тело = Новый Структура("filter", Новый Структура);
	Тело.filter.Вставить("Наименование", Наименование);
	СтатусОбработкиЗапроса = ВызовОбработчикаПолученияДанныхСписка("Справочники/Ф_Номенклатура", Тело);
	ПроверитьРезультат(СтатусОбработкиЗапроса, "Проверка ошибки", Неопределено);

КонецПроцедуры

Процедура ПолучитьЭлемент_Справочник() Экспорт
	
	Ссылка = ЮТест.Данные().СоздатьЭлемент(Справочники.Ф_Номенклатура);
	ИдентификаторСсылки = Строка(Ссылка.УникальныйИдентификатор());
	Варианты = ЮТест.Варианты("Адрес")
		.Добавить("Справочник/Ф_Номенклатура/"+ ИдентификаторСсылки)
		.Добавить("Справочники/Ф_Номенклатура/" + ИдентификаторСсылки)
		.Добавить("Справочники/Ф_Номенклатура/" + Ссылка.Код)
		.Добавить("Справочники/Ф_Номенклатура/" + Ссылка.Наименование)
	;
	
	Для Каждого Вариант Из Варианты.СписокВариантов() Цикл
		СтатусОбработкиЗапроса = ВызовОбработчикаПолучитьЗаписьТаблицы(Вариант.Адрес);
		Описание = ТестированиеСервер.Представление(Вариант, , "Вариант");
		ПроверитьРезультат(СтатусОбработкиЗапроса, Описание, Неопределено);
	КонецЦикла;
	
КонецПроцедуры

