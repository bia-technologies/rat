		Менеджер = РатМетаданные.МенеджерТаблицы(Вариант, Статус);
		
		Если СтрНачинаетсяС(Вариант, "Документ") Тогда
			Ссылка = ЮТТестовыеДанные.СоздатьДокумент(Менеджер);
		Иначе
			Ссылка = ЮТест.Данные().СоздатьЭлемент(Менеджер);
