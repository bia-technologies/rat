	Классы = РатПовтИсп.КлассыОшибок();
	
	Ссылка = ЮТест.Данные().СоздатьДокумент(Документы.Ф_Чек);
	ИдентификаторСсылки = Строка(Ссылка.УникальныйИдентификатор());
	
