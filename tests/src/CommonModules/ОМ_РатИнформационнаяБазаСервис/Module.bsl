Функция Фильтр(Реквизит, Значение, Тип = Неопределено, Условие = Неопределено, Тело = Неопределено)

	Если Тело = Неопределено Тогда
		Тело = Новый Структура("filter", Новый Массив);
	КонецЕсли;

	Предикат = Новый Структура("key, value, type, condition", Реквизит, Значение, Тип, Условие);
	Тело.filter.Добавить(Предикат);

	Возврат Тело;

КонецФункции

Процедура ПроверитьФильтрацию(Адрес, Тело, Описание, ОжидаемоеКоличество)
	
	СтатусОбработкиЗапроса = ВызовОбработчикаПолученияДанныхСписка(Адрес, Тело);
	ПроверитьРезультат(СтатусОбработкиЗапроса, Описание, Неопределено);
	
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса, Описание + ". Проверка результата")
		.Свойство("Результат").ИмеетДлину(ОжидаемоеКоличество);
	
КонецПроцедуры

Функция ТелоДанныеОбъекта(ДанныеОбъекта)
	
	Возврат Новый Структура("data", ДанныеОбъекта);
	
КонецФункции

Функция ТелоЗапросаСписка(Отбор = "!%№", Порядок = "!%№", Поля = "!%№")
	
	Тело = Новый Структура;
	
	Если Отбор <> "!%№" Тогда
		Тело.Вставить("filter", Отбор);
	КонецЕсли;
	
	Если Порядок <> "!%№" Тогда
		Тело.Вставить("order", СтрРазделить(Порядок, ", ", Ложь));
	КонецЕсли;
	
	Если Поля <> "!%№" Тогда
		Тело.Вставить("fields", СтрРазделить(Поля, ", ", Ложь));
	КонецЕсли;
	
	Возврат Тело;
	
КонецФункции

#КонецОбласти
