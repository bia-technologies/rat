// ИсполняемыеСценарии
// 	Сервисный метод для получения списка тестовых методов
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции()
		
		// Тестирование метода ПараметрыВыборки
		.ДобавитьТест("ПараметрыВыборки")
		
		// Тестирование метода ДанныеСписка
		.ДобавитьТестовыйНабор("ДанныеСписка")
			.ДобавитьТест("ДанныеСписка") // Базовый тест
			.ДобавитьТест("ДанныеСписка_ОператорыСравнения")
			.ДобавитьТест("ДанныеСписка_СложныеФильтры")
			.ДобавитьТест("ДанныеСписка_ГраничныеСлучаи")
			.ДобавитьТест("ДанныеСписка_БольшойОбъемДанных")
			.ДобавитьТест("ДанныеСписка_НулевойЛимит")
			.ДобавитьТест("ДанныеСписка_МаксимальныйЛимит")
			
		// Тестирование метода ДанныеЭлемента
		.ДобавитьТестовыйНабор("ДанныеЭлемента")
			.ДобавитьТест("ДанныеЭлемента_Справочник")
			.ДобавитьТест("ДанныеЭлемента_Документ")
			.ДобавитьТест("ДанныеЭлемента_РегистрСведений")
			.ДобавитьТест("ДанныеЭлемента_Перечисление")
			.ДобавитьТест("ДанныеЭлемента_НесуществующаяСсылка")
			
		// Тестирование метода ДанныеЗаписи
		.ДобавитьТест("ДанныеЗаписи")
		
		// Тестирование метода Предикат
		.ДобавитьТестовыйНабор("Предикат")
			.ДобавитьТест("Предикат_БазовыеОператоры")
			.ДобавитьТест("Предикат_ВалидацияПараметров")
			.ДобавитьТест("Предикат_ОператорыСравнения")
			.ДобавитьТест("Предикат_СложныеУсловия")
			.ДобавитьТест("Предикат_ПустыеЗначения")
			
		// Тестирование метода СоздатьЭлемент
		.ДобавитьТестовыйНабор("СоздатьЭлемент")
			.ДобавитьТест("СоздатьЭлемент_Справочник")
			.ДобавитьТест("СоздатьЭлемент_ГруппаСправочника")
			.ДобавитьТест("СоздатьЭлемент_СправочникСТабличнойЧастью")
			.ДобавитьТест("СоздатьЭлемент_Документ")
			.ДобавитьТест("СоздатьЭлемент_РегистрСведений")
			.ДобавитьТест("СоздатьЭлемент_ОшибкиВалидации")
			.ДобавитьТест("СоздатьЭлемент_СУказаниемСсылки")
			.ДобавитьТест("СоздатьЭлемент_ОтсутствующиеОбязательныеРеквизиты")
			.ДобавитьТест("СоздатьЭлемент_НекорректныеТипыДанных")
			
		// Тестирование метода ОбновитьЭлемент
		.ДобавитьТестовыйНабор("ОбновитьЭлемент")
			.ДобавитьТест("ОбновитьЭлемент_Справочник")
			.ДобавитьТест("ОбновитьЭлемент_СправочникСТабличнойЧастью")
			.ДобавитьТест("ОбновитьЭлемент_Документ")
			.ДобавитьТест("ОбновитьЭлемент_ПроведениеДокумента")
			.ДобавитьТест("ОбновитьЭлемент_РегистрСведений")
			.ДобавитьТест("ОбновитьЭлемент_НесуществующийОбъект")
			.ДобавитьТест("ОбновитьЭлемент_БезИзменений")
			
		// Тестирование метода УдалитьЭлемент
		.ДобавитьТестовыйНабор("УдалитьЭлемент")
			.ДобавитьТест("УдалитьЭлемент_Справочник")
			.ДобавитьТест("УдалитьЭлемент_Документ")
			.ДобавитьТест("УдалитьЭлемент_РегистрСведений")
			.ДобавитьТест("УдалитьЭлемент_НесуществующийОбъект")
			
		// Тестирование методов работы с Движениями
		.ДобавитьТестовыйНабор("Движения")
			.ДобавитьТест("ДвиженияДокументаПоРегистрам")
			.ДобавитьТест("ДвиженияПоРегистру")
			.ДобавитьТест("УстановитьДвижения_НовыеДвижения")
			.ДобавитьТест("УстановитьДвижения_ОчисткаДвижений")
			
		// Тестирование служебных методов
		.ДобавитьТестовыйНабор("СлужебныеМетоды")
			.ДобавитьТест("СсылкаПоУникальномуИдентификатору_Существующая")
			.ДобавитьТест("СсылкаПоУникальномуИдентификатору_НесуществующаяСсылка")
			.ДобавитьТест("СсылкаПоРеквизиту_НайденаСсылка")
			.ДобавитьТест("СсылкаПоРеквизиту_НеНайденаСсылка")
			.ДобавитьТест("СохранитьОбъект_УспешноеСохранение")
			.ДобавитьТест("СохранитьОбъект_ОшибкаСохранения")
	;
	
КонецПроцедуры

#Область ДанныеЭлемента

Процедура ДанныеЭлемента() Экспорт
	
	// TODO Необходимо реализовать
	// * Документ
	// * Регистры
	// * Перечисление
	
	ИмяТаблицы = "Справочник.Ф_ОбъектыМетаданных";
	Описание = "Получение данных по существующей ссылке";
	Ссылка = ЮТест.Данные().КонструкторОбъекта(ИмяТаблицы)
		.ФикцияОбязательныхПолей()
		.Фикция("Тип")
		.Записать();
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	
	ДанныеОбъкта = РатИнформационнаяБаза.ДанныеЭлемента(Ссылка, ИмяТаблицы, ОписаниеОшибок);
	ОжидаемыеДанные = Новый Структура("Наименование, Код, Тип");
	ЗаполнитьЗначенияСвойств(ОжидаемыеДанные, Ссылка);
	
	ПомощникТестированияРат.ПроверитьРезультатУспешно(ОписаниеОшибок, Описание);
	ТестированиеСервер.ОбъектыРавны(ДанныеОбъкта, ОжидаемыеДанные, , Описание);
	
	Описание = "Получение данных по существующей ссылке";
	Ссылка = Справочники.Ф_ОбъектыМетаданных.ПолучитьСсылку(Новый УникальныйИдентификатор());
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	
	ДанныеОбъкта = РатИнформационнаяБаза.ДанныеЭлемента(Ссылка, ИмяТаблицы, ОписаниеОшибок);
	ПомощникТестированияРат.ПроверитьРезультатОшибка(ОписаниеОшибок, Описание);
	
КонецПроцедуры

