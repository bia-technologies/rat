	// Обновляем запись
	Данные = РатИнформационнаяБаза.ДанныеЗаписи("РегистрСведений.Ф_КомментарииПоОбъекту");
	ЗаписьДанные = Новый Структура();
	ЗаписьДанные.Вставить("Период", Дата);
	ЗаписьДанные.Вставить("Объект", Объект);
	ЗаписьДанные.Вставить("Комментарий", "Обновленный комментарий");
	Данные.Данные.Добавить(ЗаписьДанные);
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	Результат = РатИнформационнаяБаза.ОбновитьЭлемент(КлючЗаписи, Данные, ОписаниеОшибок);
	
	ПомощникТестированияРат.ПроверитьРезультатУспешно(ОписаниеОшибок, "Обновление записи регистра");
	ЮТест.ОжидаетЧто(Результат)
		.ИмеетТип("Структура")
		.Свойство("message").Равно("Объект успешно обновлен");
	
	// Проверяем обновление
	МенеджерПроверки = РегистрыСведений.Ф_КомментарииПоОбъекту.СоздатьМенеджерЗаписи();
	МенеджерПроверки.Период = Дата;
	МенеджерПроверки.Объект = Объект;
	МенеджерПроверки.Прочитать();
	
	ЮТест.ОжидаетЧто(МенеджерПроверки.Комментарий)
		.Равно("Обновленный комментарий", "Комментарий должен быть обновлен");
	
