Процедура ДанныеЭлемента_РегистрСведений() Экспорт
	
	ИмяТаблицы = "РегистрСведений.Ф_КомментарииПоОбъекту";
	Описание = "Получение данных записи регистра сведений";
	
	// Создаем запись в регистре
	Дата = ТекущаяДата();
	Объект = ЮТест.Данные().КонструкторОбъекта(Документы.ПУБ_Чек)
		.ФикцияОбязательныхПолей()
		.Записать();
	
	МенеджерЗаписи = РегистрыСведений.Ф_КомментарииПоОбъекту.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Дата;
	МенеджерЗаписи.Объект = Объект;
	МенеджерЗаписи.Комментарий = "Тестовый комментарий для регистра";
	МенеджерЗаписи.Записать();
	
	ДанныеКлюча = Новый Структура("Период, Объект", Дата, Объект);
	КлючЗаписи = РегистрыСведений.Ф_КомментарииПоОбъекту.СоздатьКлючЗаписи(ДанныеКлюча);
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	
	ДанныеОбъкта = РатИнформационнаяБаза.ДанныеЭлемента(КлючЗаписи, ИмяТаблицы, ОписаниеОшибок);
	
	ПомощникТестированияРат.ПроверитьРезультатУспешно(ОписаниеОшибок, Описание);
	ЮТест.ОжидаетЧто(ДанныеОбъкта, Описание)
		.ИмеетТип("Структура")
		.Свойство("Период").Равно(Дата)
		.Свойство("Объект").Равно(Объект)
		.Свойство("Комментарий").Равно("Тестовый комментарий для регистра");
	
КонецПроцедуры

