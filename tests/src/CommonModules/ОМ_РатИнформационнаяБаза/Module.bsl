Процедура СоздатьЭлемент_РегистрСведений() Экспорт
	
	Дата = ТекущаяДата();
	Объект = ЮТест.Данные().КонструкторОбъекта(Документы.ПУБ_Чек)
		.ФикцияОбязательныхПолей()
		.Записать();
	
	Данные = РатИнформационнаяБаза.ДанныеЗаписи("РегистрСведений.Ф_КомментарииПоОбъекту");
	ЗаписьДанные = Новый Структура();
	ЗаписьДанные.Вставить("Период", Дата);
	ЗаписьДанные.Вставить("Объект", Объект);
	ЗаписьДанные.Вставить("Комментарий", "Тестовый комментарий создан через API");
	
	Данные.Данные.Добавить(ЗаписьДанные);
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	КлючЗаписи = РатИнформационнаяБаза.СоздатьЭлемент(Данные, ОписаниеОшибок);
	
	ПомощникТестированияРат.ПроверитьРезультатУспешно(ОписаниеОшибок, "Создание записи регистра сведений");
	ЮТест.ОжидаетЧто(КлючЗаписи)
		.ИмеетТип("РегистрСведенийКлючЗаписи.Ф_КомментарииПоОбъекту")
		.Заполнено("Должен быть создан ключ записи");
	
	// Проверяем, что запись действительно создана
	МенеджерЗаписи = РегистрыСведений.Ф_КомментарииПоОбъекту.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Дата;
	МенеджерЗаписи.Объект = Объект;
	МенеджерЗаписи.Прочитать();
	
	ЮТест.ОжидаетЧто(МенеджерЗаписи.Выбран())
		.Равно(Истина, "Запись должна существовать");
	ЮТест.ОжидаетЧто(МенеджерЗаписи.Комментарий)
		.Равно("Тестовый комментарий создан через API");
	
КонецПроцедуры

