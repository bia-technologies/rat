#Область ДанныеСписка

Процедура ДанныеСписка() Экспорт
	
	ТипОбъектов = Перечисления.Ф_ТипыОбъектов.Перечисление;
	ДругойТип = Перечисления.Ф_ТипыОбъектов.Документ;
	Записи = Новый Массив;
	
	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.ПУБ_ОбъектыМетаданных)
		.Установить("Наименование", "1")
		.Установить("Тип", ТипОбъектов);
		
	Записи.Добавить(Конструктор.Записать());
	
	Конструктор.Установить("Наименование", "2");
	Записи.Добавить(Конструктор.Записать());
	
	ИмяТаблицы = "Справочник.Ф_ОбъектыМетаданных";
	
	// По умолчанию
	Описание = "Получение списка по умолчанию";
	ПараметрыВыборки = РатИнформационнаяБаза.ПараметрыВыборки();
	ПараметрыВыборки.ИмяТаблицы = ИмяТаблицы;
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	Результат = РатИнформационнаяБаза.ДанныеСписка(ПараметрыВыборки, ОписаниеОшибок);
	
	ПомощникТестированияРат.ПроверитьРезультатУспешно(ОписаниеОшибок, Описание);
	ЮТест.ОжидаетЧто(Результат, Описание)
		.ИмеетТип(Тип("Массив"), "верный тип результата")
		.ИмеетДлинуБольше(1, "верное количество в результате");
	
	// С отбором и пустым результатом
	Описание = "Получение списка с отбором (пустой список)";
	ПараметрыВыборки = РатИнформационнаяБаза.ПараметрыВыборки();
	ПараметрыВыборки.ИмяТаблицы = ИмяТаблицы;
	ПараметрыВыборки.Отбор.Добавить(РатИнформационнаяБаза.Предикат("Тип", ДругойТип));
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	Результат = РатИнформационнаяБаза.ДанныеСписка(ПараметрыВыборки, ОписаниеОшибок);
	
	ПомощникТестированияРат.ПроверитьРезультатУспешно(ОписаниеОшибок, Описание);
	ЮТест.ОжидаетЧто(Результат, Описание)
		.ИмеетТип("Массив")
		.ИмеетДлину(0, "Результат не соответствует ожиданию");
	
	// С отбором
	Описание = "Получение списка с отбором";
	ПараметрыВыборки = РатИнформационнаяБаза.ПараметрыВыборки();
	ПараметрыВыборки.ИмяТаблицы = ИмяТаблицы;
	ПараметрыВыборки.Отбор.Добавить(РатИнформационнаяБаза.Предикат("Тип", ТипОбъектов));
	ПараметрыВыборки.Сортировка = СтрРазделить("Наименование", ",");
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	Результат = РатИнформационнаяБаза.ДанныеСписка(ПараметрыВыборки, ОписаниеОшибок);
	
	ПомощникТестированияРат.ПроверитьРезультатУспешно(ОписаниеОшибок, Описание);
	ЮТест.ОжидаетЧто(Результат, Описание)
		.ИмеетТип("Массив", "не верный тип")
		.Равно(Записи);
	
	// С отбором, сортировкой и выбираемыми полями
	Описание = "Получение списка с отбором, сортировкой и выбираемыми полями";
	ПараметрыВыборки = РатИнформационнаяБаза.ПараметрыВыборки();
	ПараметрыВыборки.ИмяТаблицы = ИмяТаблицы;
	ПараметрыВыборки.Отбор.Добавить(РатИнформационнаяБаза.Предикат("Тип", ТипОбъектов));
	ПараметрыВыборки.Сортировка.Добавить("Наименование");
	ПараметрыВыборки.ВыбираемыеПоля.Добавить("Наименование");
	ПараметрыВыборки.ВыбираемыеПоля.Добавить("Ссылка");
	ПараметрыВыборки.ВыбираемыеПоля.Добавить("Тип");
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
	Результат = РатИнформационнаяБаза.ДанныеСписка(ПараметрыВыборки, ОписаниеОшибок);
	
	ПомощникТестированияРат.ПроверитьРезультатУспешно(ОписаниеОшибок, Описание);
	ЮТест.ОжидаетЧто(Результат, Описание)
		.ИмеетТип("ТаблицаЗначений", "не верный тип")
		.ИмеетДлину(Записи.Количество())
		.Свойство("Колонки").ИмеетДлину(3);
	
КонецПроцедуры

Процедура ДанныеСписка_ОператорыСравнения() Экспорт
	
	// Подготовка тестовых данных
	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.ПУБ_ОбъектыМетаданных)
		.Установить("Наименование", "Тест больше")
		.Установить("Тип", Перечисления.Ф_ТипыОбъектов.Справочник);
	Ссылка1 = Конструктор.Записать();
	
	Конструктор.Установить("Наименование", "Тест меньше");
	Ссылка2 = Конструктор.Записать();
	
	ИмяТаблицы = "Справочник.Ф_ОбъектыМетаданных";
	
	// Тест оператора "Содержит"
	ПараметрыВыборки = РатИнформационнаяБаза.ПараметрыВыборки();
	ПараметрыВыборки.ИмяТаблицы = ИмяТаблицы;
	ПараметрыВыборки.Отбор.Добавить(РатИнформационнаяБаза.Предикат("Наименование", "больше", Неопределено, РатОбщийКлиентСервер.ВидыСравнения().Содержит));
	
	ОписаниеОшибок = ПомощникТестированияРат.Статус();
