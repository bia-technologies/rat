Процедура ТипыМетаданных() Экспорт
	
	Описание = РатМетаданные.ТипыМетаданных();
	
	КолонкиЭталон = СтрРазделить("Имя, ИмяКоллекции, ОбъектныеДанные, Редактирование, КоллекцииРеквизитов, ТабличныеЧасти, Предопределенные, Поиск", ", ", Ложь);
	КолонкиОписания = РатКоллекции.ВыгрузитьЗначения(Описание.Колонки, "Имя");
	
	ЮТест.ОжидаетЧто(КолонкиОписания, "Колонки таблицы метаданных")
		.Равно(КолонкиЭталон);
	
	ОжидаемыеИмена = Новый Массив;
	ОжидаемыеИмена.Добавить("Справочник");
	ОжидаемыеИмена.Добавить("Документ");
	ОжидаемыеИмена.Добавить("Перечисление");
	ОжидаемыеИмена.Добавить("ПланВидовХарактеристик");
	ОжидаемыеИмена.Добавить("ПланСчетов");
	ОжидаемыеИмена.Добавить("ПланВидовРасчета");
	ОжидаемыеИмена.Добавить("ПланОбмена");
	ОжидаемыеИмена.Добавить("РегистрСведений");
	ОжидаемыеИмена.Добавить("РегистрНакопления");
	ОжидаемыеИмена.Добавить("РегистрБухгалтерии");
	ОжидаемыеИмена.Добавить("РегистрРасчета");
	ОжидаемыеИмена.Добавить("БизнесПроцесс");
	ОжидаемыеИмена.Добавить("Задача");
	ИменаОписания = РатКоллекции.ВыгрузитьЗначения(Описание, "Имя");
	
	ЮТест.ОжидаетЧто(ИменаОписания, "Имена описаных объектов")
		.Равно(ОжидаемыеИмена);
	
КонецПроцедуры

Процедура РеквизитыОбъектаМетаданных() Экспорт
	
	ОписаниеКоллекции = РатМетаданные.ТипыМетаданных().Найти("Справочник", "Имя");
	МетаОбъект = Метаданные.Справочники.Ф_ОбъектыМетаданных;
	Реквизиты = РатМетаданные.РеквизитыОбъектаМетаданных(МетаОбъект, ОписаниеКоллекции);
	
	ИменаРеквизитов = РатКоллекции.ВыгрузитьЗначения(Реквизиты, "Имя");
	ЮТест.ОжидаетЧто(ИменаРеквизитов, "Список реквизитов не соответствует ожиданию")
		.Содержит("Код")
		.Содержит("Наименование")
		.Содержит("Тип")
		.Содержит("Родитель")
		.НеСодержит("Владелец");
	
