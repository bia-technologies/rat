Процедура СтруктураТаблицы() Экспорт
	
	Описание = РатМетаданные.СтруктураТаблицы("Справочник.Ф_ОбъектыМетаданных");
	ЮТест.ОжидаетЧто(Описание.Реквизиты, "Описание реквизитов справочника `ОбъектыМетаданных`")
		.ИмеетСвойство("Наименование")
		.ИмеетСвойство("Тип")
		.ИмеетСвойство("Предопределенный")
		.ИмеетСвойство("Родитель")
		.КаждыйЭлементСоответствуетПредикату(ЮТест.Предикат()
			.Реквизит("Значение").ИмеетТип("ОписаниеТипов"));
	
	Описание = РатМетаданные.СтруктураТаблицы("РегистрСведений.Ф_ИзмерениеСоставнойРеквизит");
	ЮТест.ОжидаетЧто(Описание, "Описание структуры регистра сведений `ИзмерениеСоставнойРеквизит`")
		.ИмеетСвойство("Реквизиты.ИзмерениеЛюбаяСсылка")
		.ИмеетСвойство("Реквизиты.Значение");
	
	ТипРеквизита = Описание.Реквизиты.Значение;
	ЮТест.ОжидаетЧто(ТипРеквизита.СодержитТип(Тип("Null"))).ЭтоЛожь("отсутствует тип Null");
	ЮТест.ОжидаетЧто(ТипРеквизита.Типы())
		.ИмеетДлину(1, "содержит только одно значени");
	
	ТипРеквизита = Описание.Реквизиты.ИзмерениеЛюбаяСсылка;
	ЮТест.ОжидаетЧто(ТипРеквизита.Типы(), "Составной тип")
		.ИмеетДлинуБольше(5, "содержит много вложенных типов");
	
