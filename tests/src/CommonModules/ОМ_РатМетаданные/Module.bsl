КонецПроцедуры

Процедура МетаданныеТаблицы(Имя, ИменаРеквизитов) Экспорт
	
	Реквизиты = СтрРазделить(ИменаРеквизитов, ", ", Ложь);
	ЭтоРегистр = СтрНачинаетсяС(Имя, "Регистр");
	
	Статус = ПомощникТестированияРат.Статус();
	Результат = РатМетаданные.МетаданныеТаблицы(Имя, Статус);
	ЮТест.ОжидаетЧто(Результат, Имя)
		.Свойство("Реквизиты")
		.Свойство("КлючевыеРеквизиты")
		.Свойство("Имя")
		.Свойство("Представление")
		.Свойство("ЭтоРегистр").Равно(ЭтоРегистр);
	
	РеквизитыТаблицы = РатКоллекции.ВСоответствие(Результат.Реквизиты, "Имя");
	Для Каждого Реквизит Из Реквизиты Цикл
		ЮТест.ОжидаетЧто(РеквизитыТаблицы, Имя)
			.Свойство(Реквизит).ИмеетТип("Структура")
			.Свойство(Реквизит + ".Имя").Равно(Реквизит);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбъектМетаданных(Имя) Экспорт
	
	СтруктураИмени = РатМетаданные.РазложитьИмяТаблицы(Имя);
	Результат = РатМетаданные.ОбъектМетаданных(Имя);
	ЮТест.ОжидаетЧто(Результат, "По имени")
		.Существует()
		.ИмеетТип("ОбъектМетаданных");
	
	Результат2 = РатМетаданные.ОбъектМетаданных(СтруктураИмени);
	ЮТест.ОжидаетЧто(Результат2, "По структуре имени")
		.Существует()
		.ИмеетТип("ОбъектМетаданных")
		.Равно(Результат);
	
	ЮТест.ОжидаетЧто(Результат.Имя, "Проверка имени")
		.Равно(СтруктураИмени.ИмяВида);
	
КонецПроцедуры

Процедура ЭтоТаблицаОбъектныхДанных() Экспорт
	
	Варианты = ЮТТестовыеДанные.ТаблицаMarkDown(
	"| Имя                              | Результат |
	||----------------------------------|-----------|
	|| Справочник.Ф_Номенклатура      | +         |
	|| Документ.Ф_Чек                 | +         |
	|| Перечисление.Ф_ВидыОпераций    | +         |
	|| ПланВидовХарактеристик.Ф_ПВХ   | +         |
	|| РегистрыСведений.Ф_КомментарииПоОбъекту | -         |
	|| РегистрНакопления.Ф_ОстаткиТоваров | -         |");
	
	Для Каждого Вариант Из Варианты Цикл
		
		ОжидаемыйРезультат = Вариант.Результат = "+";
		Результат = РатМетаданные.ЭтоТаблицаОбъектныхДанных(Вариант.Имя);
		ЮТест.ОжидаетЧто(Результат, Вариант.Имя)
			.Равно(ОжидаемыйРезультат);
		
		СтруктураИмени = РатМетаданные.РазложитьИмяТаблицы(Вариант.Имя);
		Результат = РатМетаданные.ЭтоТаблицаОбъектныхДанных(СтруктураИмени);
		ЮТест.ОжидаетЧто(Результат, "По структуре имени " + Вариант.Имя)
			.Равно(ОжидаемыйРезультат);
		
	КонецЦикла;
КонецПроцедуры

Процедура ТипМетаданных() Экспорт
	
	Варианты = ЮТТестовыеДанные.ТаблицаMarkDown(
	"| Имя                    | Редактирование |
	|| ---------------------- | -------------- |
	|| Справочник             | +              |
	|| Документ               | +              |
	|| Перечисление           | -              |
	|| ПланВидовХарактеристик | +              |
	|| ПланСчетов             | +              |
	|| ПланВидовРасчета       | +              |
	|| РегистрСведений        | +              |
	|| РегистрНакопления      | -              |
	|| РегистрБухгалтерии     | -              |
	|| РегистрРасчета         | -              |
	|| БизнесПроцесс          | +              |
	|| Задача                 | +              |");
	
	Для Каждого Вариант Из Варианты Цикл
		
		ЮТест.ОжидаетЧто(РатМетаданные.ТипМетаданных(Вариант.Имя), Вариант.Имя)
			.Заполнено()
			.Свойство("ИмяКоллекции")
			.Свойство("Имя").Равно(Вариант.Имя)
			.Свойство("ОбъектныеДанные")
			.Свойство("Редактирование").Равно(Вариант.Редактирование = "+")
			.Свойство("КоллекцииРеквизитов")
			.Свойство("ТабличныеЧасти")
			.Свойство("Предопределенные")
			.Свойство("Поиск")
		;
	КонецЦикла;
	
КонецПроцедуры

Процедура МенеджерТаблицы(ИмяТаблицы, Успешно) Экспорт
	
	Статус = ПомощникТестированияРат.Статус();
	Результат = РатМетаданные.МенеджерТаблицы(ИмяТаблицы, Статус);
	
	Если Успешно Тогда
		ЮТест.ОжидаетЧто(Статус, "Статус для " + ИмяТаблицы)
			.Свойство("Успешно").ЭтоИстина("успешен")
			.Что(Результат, "Менеджер для " + ИмяТаблицы)
			.Существует();
	Иначе
		ЮТест.ОжидаетЧто(Статус, "Статус для " + ИмяТаблицы)
			.Свойство("Успешно").ЭтоЛожь("провелен")
			.Что(Результат, "Менеджер для " + ИмяТаблицы)
			.НеСуществует();
	КонецЕсли;
		
КонецПроцедуры

Процедура ТаблицыДвижений() Экспорт
	
	ЮТест.ОжидаетЧто(РатМетаданные.ТаблицыДвижений("Документ.Ф_Чек"), "Движения чека")
		.ИмеетДлину(1)
		.Свойство("Ф_ОстаткиТоваров").Равно("РегистрНакопления.Ф_ОстаткиТоваров");
	
КонецПроцедуры

Процедура ПолноеИмяТаблицыДвижений() Экспорт
	
	ЮТест.ОжидаетЧто(РатМетаданные.ПолноеИмяТаблицыДвижений("Документ.Ф_Чек", "Ф_ОстаткиТоваров"), "Существующий регистр")
		.Равно("РегистрНакопления.Ф_ОстаткиТоваров");
	
	ЮТест.ОжидаетЧто(РатМетаданные.ПолноеИмяТаблицыДвижений("Документ.Ф_Чек", "Ф_ОстаткиТоваров2"), "Несуществующий регистр")
		.ЭтоНеопределено();
	
КонецПроцедуры

Процедура РазложитьИмяТаблицы() Экспорт
	
	Варианты = ЮТТестовыеДанные.ТаблицаMarkDown(
		"| Имя                              | Тип               | Вид             |
		||----------------------------------|-------------------|-----------------|
		|| Справочник.Ф_Номенклатура      | Справочник        | Ф_Номенклатура|
		|| Документ.Ф_Чек                 | Документ          | Ф_Чек         |
		|| Перечисление.Ф_ВидыОпераций    | Перечисление      | Ф_ВидыОпераций|
		|| РегистрыСведений.Ф_КомментарииПоОбъекту | РегистрСведений   | Ф_КомментарииПоОбъекту |
		|| РегистрНакопления.Ф_ОстаткиТоваров | РегистрНакопления | Ф_ОстаткиТоваров |
		|| Справочники.Ф_Номенклатура2   | Справочник        | Ф_Номенклатура2|");
	
	Для Каждого Вариант Из Варианты Цикл
		
		Результат = РатМетаданные.РазложитьИмяТаблицы(Вариант.Имя);
		ЮТест.ОжидаетЧто(Результат, Вариант.Имя)
			.ИмеетТип("Структура")
			.Свойство("ИмяТипа").Равно(Вариант.Тип)
			.Свойство("ИмяВида").Равно(Вариант.Вид)
			.Свойство("Тип.Имя").Равно(Вариант.Тип);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаСодержитПредопределенный(Имя, Предопределенный, ОжидаемыйРезультат) Экспорт
		
	Результат = РатМетаданные.ТаблицаСодержитПредопределенный(Имя, Предопределенный);
	ЮТест.ОжидаетЧто(Результат, "Проверка наличия предопределенного элемента " + Предопределенный + " в таблице " + Имя)
		.Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

Процедура ДоступноРедактирование() Экспорт
	
	Варианты = Новый Массив;
	Варианты.Добавить(Новый Структура("Имя, Результат", "Справочник.Валюты", Истина));
	Варианты.Добавить(Новый Структура("Имя, Результат", "Справочник", Истина));
	Варианты.Добавить(Новый Структура("Имя, Результат", "Документ.ЧекККМ", Истина));
	Варианты.Добавить(Новый Структура("Имя, Результат", "РегистрНакопления.КассовыеСмены", Ложь));
	Варианты.Добавить(Новый Структура("Имя, Результат", "РегистрНакопления", Ложь));
	Варианты.Добавить(Новый Структура("Имя, Результат", "Перечисление.КатегорииСМС", Ложь));
	Варианты.Добавить(Новый Структура("Имя, Результат", "ПланВидовХарактеристик.ТипыЗначенийВидовПравДоступа", Истина));
	
	Для Каждого Вариант Из Варианты Цикл
		
		ЮТест.ОжидаетЧто(РатМетаданные.ТипМетаданных(Вариант.Имя), Вариант.Имя)
			.Свойство("Редактирование").Равно(Вариант.Результат);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ТаблицаСодержитОбъектныеДанные() Экспорт
	
	Варианты = Новый Массив;
	Варианты.Добавить(Новый Структура("Имя, Результат", "Справочник.Валюты", Истина));
	Варианты.Добавить(Новый Структура("Имя, Результат", "Документ.ЧекККМ", Истина));
	Варианты.Добавить(Новый Структура("Имя, Результат", "РегистрНакопления.КассовыеСмены", Ложь));
	Варианты.Добавить(Новый Структура("Имя, Результат", "Перечисление.КатегорииСМС", Истина));
	Варианты.Добавить(Новый Структура("Имя, Результат", "ПланВидовХарактеристик.ТипыЗначенийВидовПравДоступа", Истина));
	
	Для Каждого Вариант Из Варианты Цикл
		
		Результат = РатМетаданные.ТаблицаСодержитОбъектныеДанные(Вариант.Имя);
		ЮТест.ОжидаетЧто(Результат, Вариант.Имя)
			.Равно(Вариант.Результат, "корректная проверка `ТаблицаСодержитОбъектныеДанные`")
		
	КонецЦикла;
	
